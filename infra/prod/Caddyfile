# TLS from Let's Encrypt, automatic renewal. DOMAIN and ACME_EMAIL come from prgd.env.
{
    email {$ACME_EMAIL}
}

(common) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

{$DOMAIN} {
    import common
    reverse_proxy www:3001
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

console.{$DOMAIN} {
    import common
    reverse_proxy console:3000
}

# DevOps console for on call engineers. The app sets its own Content Security Policy with a nonce
# per request; these are the same static headers it sends, repeated here so they hold even for
# responses the app does not produce (errors from the proxy).
ops.{$DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Cross-Origin-Opener-Policy same-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-read=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
        X-Robots-Tag "noindex, nofollow"
        -Server
        -X-Powered-By
    }
    reverse_proxy ops:3002
}

api.{$DOMAIN} {
    import common
    # Long polling and webhook bodies are small; keep uploads bounded.
    request_body {
        max_size 2MB
    }
    reverse_proxy api:4000 {
        header_up X-Forwarded-For {remote_host}
    }
}

# Terminal gateway: WebSockets from the ops console only (the gateway checks Origin). Nothing
# but /v1/terminal is published; no compression on upgraded connections.
gateway.{$DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
    @terminal path /v1/terminal
    handle @terminal {
        reverse_proxy gateway:4100 {
            header_up X-Forwarded-For {remote_host}
            # Keep terminals open across Caddy config reloads.
            stream_close_delay 4h
        }
    }
    handle {
        respond 404
    }
}
