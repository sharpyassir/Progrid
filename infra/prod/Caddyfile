# TLS from Let's Encrypt, automatic renewal. DOMAIN and ACME_EMAIL come from prgd.env.
{
    email {$ACME_EMAIL}
}

(common) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

{$DOMAIN} {
    import common
    reverse_proxy www:3001
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

console.{$DOMAIN} {
    import common
    reverse_proxy console:3000
}

api.{$DOMAIN} {
    import common
    # Long polling and webhook bodies are small; keep uploads bounded.
    request_body {
        max_size 2MB
    }
    reverse_proxy api:4000 {
        header_up X-Forwarded-For {remote_host}
    }
}
