# /etc/prgd/prgd.env — rendered by Ansible from the vault; this file shows the shape.
# Everything the API reads (see .env.example at the repo root) plus what compose itself needs.

# compose. Two domains, one platform (docs/domains-and-entities.md): DOMAIN is the primary,
# global one; DOMAIN_SA serves the same apps for customers in Saudi Arabia.
DOMAIN=progrid.co
DOMAIN_SA=progrid.sa
ACME_EMAIL=hostmaster@progrid.co
REGISTRY=ghcr.io/sharpyassir
IMAGE_TAG=latest
MGMT_IP=10.0.0.10                # management network address host agents reach NATS on
POSTGRES_PASSWORD=change-me
NATS_TOKEN=change-me
BACKUP_KEEP_DAYS=14
BACKUP_S3_URL=                   # s3://bucket/prgd (optional)
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# age public key (age1...): dumps and off server WAL copies are encrypted to it. Generate the key
# pair off the server (age-keygen) and keep the private key off it. Empty: plain .sql.gz files.
BACKUP_AGE_RECIPIENT=
# Redis AUTH (openssl rand -hex 32; hex only, it goes into REDIS_URL). Empty: no password.
REDIS_PASSWORD=
# Caddy: /admin/* and /docs on the api hosts only from these CIDRs (space separated, in quotes).
# Empty allows every source. STAFF_IP_ALLOWLIST is the same list, comma separated, for the API.
ADMIN_ALLOW_CIDRS="198.51.100.7/32 203.0.113.0/24"
STAFF_IP_ALLOWLIST=198.51.100.7/32,203.0.113.0/24
# Optional limits (docker-compose.yml), e.g. API_MEM_LIMIT=1g WORKER_MEM_LIMIT=1g POSTGRES_MEM_LIMIT=2g
# BACKEND_SUBNET=172.29.10.0/24   # backend Docker network; PowerDNS's API only answers it

# api and worker
PORT=4000
TEMPORAL_NAMESPACE=default
HYPERVISOR_DRIVER=proxmox        # fake on a demo box with no Proxmox
PROXMOX_URL=https://pve1.mgmt.internal:8006
PROXMOX_TOKEN_ID=prgd@pve!control-plane
PROXMOX_TOKEN_SECRET=change-me
PROXMOX_CEPH_POOL=vm-disks
PROXMOX_VXLAN_ZONE=customers
# shared_bridge: one private bridge for every project; sdn_vnet: a VXLAN VNet per project
# (isolation between customers, needs the SDN zone). New installs: sdn_vnet.
PRIVATE_NETWORK_MODE=sdn_vnet
# Encrypts secrets at rest (TOTP seeds, database passwords, app env vars, tokens). Production
# refuses to start with keys under 32 characters or equal to JWT_SECRET. Generate each with
# `openssl rand -base64 32`; rotation: docs/security/key-management.md.
SECRETS_KEY=
SECRETS_KEYS=
SECRETS_LEGACY_KEY=
JWT_SECRET=change-me-64-random-bytes
SESSION_TTL_SECONDS=86400
# Staff must use two factor sign in before any back office call
REQUIRE_TOTP_FOR_STAFF=true
REQUIRE_TOTP_FOR_OWNERS=true
# Primary addresses (staff links, mail without a billing company)
CONSOLE_URL=https://console.progrid.co
PUBLIC_API_URL=https://api.progrid.co
WWW_URL=https://progrid.co
CORS_EXTRA_ORIGINS=              # more browser origins allowed to call the API with credentials
GEOIP_DB_PATH=/opt/prgd/geoip/dbip-country-lite.mmdb   # in the api image; signup country prefill only
# Object storage: fake serves an in memory S3 from the API; rgw uses the Ceph RADOS Gateway on the cluster
OBJECT_STORAGE_PROVIDER=rgw
S3_ENDPOINT=https://s3.sa1.progrid.sa
S3_REGION=sa1
RGW_ADMIN_URL=https://s3.sa1.progrid.sa
RGW_ADMIN_ACCESS_KEY=change-me
RGW_ADMIN_SECRET_KEY=change-me
# DNS: fake keeps zones in memory; powerdns publishes them through the pdns service (profile dns)
DNS_PROVIDER=powerdns
PDNS_API_URL=http://pdns:8081
PDNS_API_KEY=change-me
DNS_NAMESERVERS=ns1.progrid.sa,ns2.progrid.sa
DNS_HOSTMASTER=hostmaster@progrid.sa
# Billing companies. Billing country SA: Progrid Arabia (SAR, 15% VAT, ZATCA, Moyasar). Any other
# country: Progrid Technologies LLC (USD, Stripe). Empty details print a placeholder on invoices.
COMPANY_NAME=Progrid
ENTITY_LLC_DOMAIN=progrid.co
ENTITY_LLC_LEGAL_NAME="Progrid Technologies LLC"
ENTITY_LLC_ADDRESS=              # registered address in the United States (owner to provide)
ENTITY_LLC_EIN=                  # EIN (owner to provide)
ENTITY_LLC_TAX_RATE=0            # 0 prints no tax line
ENTITY_LLC_TAX_LABEL=Tax
ENTITY_LLC_BANK_DETAILS=         # "Bank | Account | Routing", printed under How to pay
ENTITY_LLC_SUPPORT_EMAIL=support@progrid.co
ENTITY_LLC_MAIL_FROM="Progrid <no-reply@progrid.co>"
ENTITY_LLC_TERMS_URL=            # empty: https://progrid.co/legal/terms
ENTITY_ARABIA_DOMAIN=progrid.sa
ENTITY_ARABIA_LEGAL_NAME="Progrid Arabia"
ENTITY_ARABIA_ADDRESS="Riyadh, Kingdom of Saudi Arabia"
ENTITY_ARABIA_CR=                # commercial registration (owner to provide)
ENTITY_ARABIA_VAT_NUMBER=        # 15 digit VAT number (owner to provide)
ENTITY_ARABIA_VAT_RATE=0.15
ENTITY_ARABIA_BANK_DETAILS=
ENTITY_ARABIA_SUPPORT_EMAIL=support@progrid.sa
ENTITY_ARABIA_MAIL_FROM="Progrid <no-reply@progrid.sa>"
ENTITY_ARABIA_TERMS_URL=         # empty: https://progrid.sa/legal/terms
PAYMENT_PROVIDER=moyasar         # Progrid Arabia
MOYASAR_SECRET_KEY=change-me
MOYASAR_WEBHOOK_SECRET=change-me
PAYMENT_PROVIDER_LLC=stripe      # Progrid Technologies LLC
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me  # whsec_... of https://api.progrid.co/v1/billing/payments/stripe/webhook
MAIL_PROVIDER=resend
# Sender of staff and system mail; customers get the sender of their billing company
MAIL_FROM="Progrid <no-reply@progrid.co>"
# Staff inbox for new tickets and replies; empty disables. Mail to both support addresses is accepted.
SUPPORT_INBOX=support@progrid.co
# Shared secret for the inbound email webhook (POST /v1/support/inbound); empty disables email intake
SUPPORT_INBOUND_SECRET=
# Signing secret (whsec_...) of the Resend webhook for email.received (POST /v1/support/inbound/resend); empty disables it
RESEND_WEBHOOK_SECRET=
MAIL_API_KEY=change-me
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=USD
FX_USD_SAR=3.75
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# Managed cloud (docs/managed-cloud-operations.md)
ALERTMANAGER_WEBHOOK_SECRET=change-me
PAGING_MODE=live                 # log records pages without sending them
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM=                     # E.164 SMS sender
TWILIO_WHATSAPP_FROM=            # E.164 WhatsApp sender
PUSH_WEBHOOK_URL=
PAGE_ACK_TIMEOUT_SECONDS=600
MANAGED_HEARTBEAT_STALE_MINUTES=10
MAINTENANCE_RUNNER=ansible       # fake until the worker has ansible-playbook and SSH access to the management network
MAINTENANCE_PLAYBOOK_DIR=/opt/prgd/maintenance
MAINTENANCE_SSH_USER=prgd
MAINTENANCE_SSH_KEY_FILE=/run/secrets/maintenance_ssh_key
MAINTENANCE_TIMEOUT_MINUTES=60
MANAGED_REPORT_AUTOSEND_DAY=3

# DevOps console (docs/devops-console.md)
PRGD_OPS_URL=https://ops.progrid.co    # primary: staff register passkeys here
PRGD_OPS_RP_ID=ops.progrid.co
PRGD_OPS_URL_SA=https://ops.progrid.sa # same app; passkeys are per domain and do not carry over
PRGD_OPS_RP_ID_SA=ops.progrid.sa
PRGD_OPS_RP_NAME=Progrid Ops
PRGD_OPS_SESSION_TTL_SECONDS=43200
PRGD_GRAFANA_URL=https://grafana.progrid.sa
PRGD_OPS_TIMER_IDLE_PROMPT_SECONDS=3600
PRGD_OPS_TIMER_AUTO_STOP_SECONDS=5400
PRGD_SSH_CA=step-ca
PRGD_STEPCA_URL=https://ca.internal.progrid.sa:9000
PRGD_STEPCA_PROVISIONER=prgd-gateway
PRGD_STEPCA_JWK=change-me             # the provisioner's encrypted key from ca.json
PRGD_STEPCA_PASSWORD=change-me
PRGD_STEPCA_ROOT_FINGERPRINT=
PRGD_SSH_LOGIN_USER=prgd
PRGD_SSH_PORT=22
PRGD_GATEWAY_SECRET=change-me
PRGD_GATEWAY_PUBLIC_URL=wss://gateway.progrid.co   # sessions opened from ops.progrid.sa get gateway.progrid.sa
PRGD_GATEWAY_TOKEN_TTL_SECONDS=60
PRGD_GATEWAY_SOURCE_ADDRESSES=10.8.0.2/32
# The gateway container (services/prgd-gateway). Set PRGD_GATEWAY_KNOWN_HOSTS to
# /etc/prgd-gateway/known_hosts once the assets' host keys are collected (trust on first use until then).
PRGD_GATEWAY_ID=gw-1
PRGD_GATEWAY_ALLOWED_ORIGINS=https://ops.progrid.co,https://ops.progrid.sa
PRGD_GATEWAY_KNOWN_HOSTS=
PRGD_GATEWAY_MAX_SESSIONS=50
PRGD_RECORDINGS_BUCKET=prgd-session-recordings
PRGD_SECRET_STORE=vault               # vault or infisical; never local in production
PRGD_VAULT_ADDR=https://vault.internal.progrid.sa:8200
PRGD_VAULT_TOKEN=change-me
PRGD_VAULT_MOUNT=prgd
PRGD_INFISICAL_URL=https://app.infisical.com
PRGD_INFISICAL_TOKEN=
PRGD_INFISICAL_PROJECT=
PRGD_INFISICAL_ENV=prod
# Social sign in (docs/social-sign-in.md). Register both redirect URIs with each provider:
#   https://api.progrid.co/v1/auth/oauth/{google,microsoft}/callback
#   https://api.progrid.sa/v1/auth/oauth/{google,microsoft}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=change-me
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=change-me
MICROSOFT_TENANT=common
OAUTH_REDIRECT_BASE=             # empty: api.<domain> of the domain the sign in started on
# Progrid Connect (docs/connect.md). Without ANTHROPIC_API_KEY agents run on the fake model.
ANTHROPIC_API_KEY=change-me
CONNECT_MODEL_PROVIDER=anthropic
CONNECT_DEFAULT_MODEL=claude-opus-5-5
CONNECT_MODEL_FALLBACKS=true
CONNECT_MAX_OUTPUT_TOKENS=16000
CONNECT_PUBLIC_BASE_URL=https://api.progrid.co   # only when a request came through neither domain
CONNECT_MAX_AGENTS_PER_TEAM=50
CONNECT_MAX_CONNECTIONS_PER_TEAM=50
CONNECT_MAX_CONCURRENT_RUNS=10
CONNECT_RUNS_PER_MINUTE_PER_AGENT=60
CONNECT_RUNS_PER_MINUTE_PER_TEAM=300
CONNECT_PLATFORM_EMAILS_PER_HOUR=50
CONNECT_NETWORK_ALLOWLIST=
CONNECT_SYNC_TIMEOUT_SECONDS=60
