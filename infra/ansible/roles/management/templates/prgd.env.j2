# Managed by Ansible. Edit group_vars and re-run the playbook; do not edit by hand.
DOMAIN={{ domain }}
ACME_EMAIL={{ acme_email }}
REGISTRY={{ registry }}
IMAGE_TAG={{ image_tag }}
MGMT_IP={{ mgmt_ip }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
NATS_TOKEN={{ vault_nats_token }}
BACKUP_KEEP_DAYS={{ backup_keep_days }}
BACKUP_S3_URL={{ backup_s3_url }}
BACKUP_S3_KEY={{ vault_backup_s3_key | default('') }}
BACKUP_S3_SECRET={{ vault_backup_s3_secret | default('') }}

PORT=4000
TEMPORAL_NAMESPACE=default
HYPERVISOR_DRIVER={{ hypervisor_driver }}
PROXMOX_URL={{ proxmox_url }}
PROXMOX_TOKEN_ID={{ proxmox_token_id }}
PROXMOX_TOKEN_SECRET={{ vault_proxmox_token_secret | default('') }}
PROXMOX_CEPH_POOL={{ proxmox_ceph_pool }}
PROXMOX_VXLAN_ZONE={{ proxmox_vxlan_zone }}
JWT_SECRET={{ vault_jwt_secret }}
SECRETS_KEY={{ vault_secrets_key }}
SESSION_TTL_SECONDS=86400
REQUIRE_TOTP_FOR_OWNERS={{ require_totp_for_owners | lower }}
CONSOLE_URL=https://console.{{ domain }}
PUBLIC_API_URL=https://api.{{ domain }}
MAIL_PROVIDER={{ mail_provider }}
MAIL_FROM="{{ mail_from }}"
MAIL_API_KEY={{ vault_mail_api_key | default('') }}
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=SAR
FX_USD_SAR={{ fx_usd_sar }}
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# Company details printed on invoices
COMPANY_NAME={{ company_name }}
COMPANY_ADDRESS="{{ company_address }}"
COMPANY_TAX_ID={{ company_tax_id }}

# Payments. Never leave this on "fake" outside a demo: the fake provider lets anyone add credit.
PAYMENT_PROVIDER={{ payment_provider }}
MOYASAR_SECRET_KEY={{ vault_moyasar_secret_key | default('') }}
MOYASAR_WEBHOOK_SECRET={{ vault_moyasar_webhook_secret | default('') }}

# Support inbox and the inbound email webhook secret
SUPPORT_INBOX={{ support_inbox }}
SUPPORT_INBOUND_SECRET={{ vault_support_inbound_secret | default('') }}

# DNS and object storage providers (fake keeps everything in memory; only for demos)
DNS_PROVIDER={{ dns_provider }}
PDNS_API_URL=http://pdns:8081
PDNS_API_KEY={{ vault_pdns_api_key | default('') }}
DNS_NAMESERVERS={{ dns_nameservers }}
OBJECT_STORAGE_PROVIDER={{ object_storage_provider }}
S3_ENDPOINT={{ s3_endpoint }}
RGW_ADMIN_ACCESS_KEY={{ vault_rgw_admin_access_key | default('') }}
RGW_ADMIN_SECRET_KEY={{ vault_rgw_admin_secret_key | default('') }}

# Networks allowed to reach platform agents (SSH and :9009) on customer facing nodes
CONTROL_PLANE_CIDR={{ control_plane_cidr }}

# Managed cloud: Alertmanager receiver, paging and maintenance runs (docs/managed-cloud-operations.md)
ALERTMANAGER_WEBHOOK_SECRET={{ vault_alertmanager_webhook_secret | default('') }}
PAGING_MODE={{ paging_mode | default('log') }}
TWILIO_ACCOUNT_SID={{ twilio_account_sid | default('') }}
TWILIO_AUTH_TOKEN={{ vault_twilio_auth_token | default('') }}
TWILIO_FROM={{ twilio_from | default('') }}
TWILIO_WHATSAPP_FROM={{ twilio_whatsapp_from | default('') }}
PUSH_WEBHOOK_URL={{ push_webhook_url | default('') }}
PAGE_ACK_TIMEOUT_SECONDS={{ page_ack_timeout_seconds | default(600) }}
MANAGED_HEARTBEAT_STALE_MINUTES={{ managed_heartbeat_stale_minutes | default(10) }}
MAINTENANCE_RUNNER={{ maintenance_runner | default('fake') }}
MAINTENANCE_PLAYBOOK_DIR={{ maintenance_playbook_dir | default('/opt/prgd/maintenance') }}
MAINTENANCE_SSH_USER={{ maintenance_ssh_user | default('prgd') }}
MAINTENANCE_SSH_KEY_FILE={{ maintenance_ssh_key_file | default('') }}
MAINTENANCE_TIMEOUT_MINUTES={{ maintenance_timeout_minutes | default(60) }}
MANAGED_REPORT_AUTOSEND_DAY={{ managed_report_autosend_day | default(3) }}
