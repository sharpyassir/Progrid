# Managed by Ansible. Edit group_vars and re-run the playbook; do not edit by hand.
DOMAIN={{ domain }}
ACME_EMAIL={{ acme_email }}
REGISTRY={{ registry }}
IMAGE_TAG={{ image_tag }}
# NATS listens here for the host agents: the WireGuard address when the management network is up
MGMT_IP={{ nats_bind_ip }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
NATS_TOKEN={{ vault_nats_token }}
BACKUP_KEEP_DAYS={{ backup_keep_days }}
BACKUP_S3_URL={{ backup_s3_url }}
BACKUP_S3_KEY={{ vault_backup_s3_key | default('') }}
BACKUP_S3_SECRET={{ vault_backup_s3_secret | default('') }}

PORT=4000
TEMPORAL_NAMESPACE=default
HYPERVISOR_DRIVER={{ hypervisor_driver }}
PROXMOX_URL={{ proxmox_url }}
PROXMOX_TOKEN_ID={{ proxmox_token_id }}
PROXMOX_TOKEN_SECRET={{ vault_proxmox_token_secret | default('') }}
PROXMOX_CEPH_POOL={{ proxmox_ceph_pool }}
PROXMOX_VXLAN_ZONE={{ proxmox_vxlan_zone }}
JWT_SECRET={{ vault_jwt_secret }}
SECRETS_KEY={{ vault_secrets_key }}
SESSION_TTL_SECONDS=86400
REQUIRE_TOTP_FOR_OWNERS={{ require_totp_for_owners | lower }}
CONSOLE_URL=https://console.{{ domain }}
PUBLIC_API_URL=https://api.{{ domain }}
MAIL_PROVIDER={{ mail_provider }}
MAIL_FROM="{{ mail_from }}"
MAIL_API_KEY={{ vault_mail_api_key | default('') }}
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=SAR
FX_USD_SAR={{ fx_usd_sar }}
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# Company details printed on invoices
COMPANY_NAME={{ company_name }}
COMPANY_ADDRESS="{{ company_address }}"
COMPANY_TAX_ID={{ company_tax_id }}

# Payments. Never leave this on "fake" outside a demo: the fake provider lets anyone add credit.
PAYMENT_PROVIDER={{ payment_provider }}
MOYASAR_SECRET_KEY={{ vault_moyasar_secret_key | default('') }}
MOYASAR_WEBHOOK_SECRET={{ vault_moyasar_webhook_secret | default('') }}

# Support inbox and the inbound email webhook secret
SUPPORT_INBOX={{ support_inbox }}
SUPPORT_INBOUND_SECRET={{ vault_support_inbound_secret | default('') }}
# Svix signing secret of the Resend email.received webhook (POST /v1/support/inbound/resend)
RESEND_WEBHOOK_SECRET={{ vault_resend_webhook_secret | default('') }}

# DNS and object storage providers (fake keeps everything in memory; only for demos)
DNS_PROVIDER={{ dns_provider }}
PDNS_API_URL=http://pdns:8081
PDNS_API_KEY={{ vault_pdns_api_key | default('') }}
DNS_NAMESERVERS={{ dns_nameservers }}
OBJECT_STORAGE_PROVIDER={{ object_storage_provider }}
S3_ENDPOINT={{ s3_endpoint }}
RGW_ADMIN_ACCESS_KEY={{ vault_rgw_admin_access_key | default('') }}
RGW_ADMIN_SECRET_KEY={{ vault_rgw_admin_secret_key | default('') }}

# Networks allowed to reach platform agents (SSH and :9009) on customer facing nodes
CONTROL_PLANE_CIDR={{ control_plane_cidr }}

# Managed cloud: Alertmanager receiver, paging and maintenance runs (docs/managed-cloud-operations.md)
ALERTMANAGER_WEBHOOK_SECRET={{ vault_alertmanager_webhook_secret | default('') }}
PAGING_MODE={{ paging_mode | default('log') }}
TWILIO_ACCOUNT_SID={{ twilio_account_sid | default('') }}
TWILIO_AUTH_TOKEN={{ vault_twilio_auth_token | default('') }}
TWILIO_FROM={{ twilio_from | default('') }}
TWILIO_WHATSAPP_FROM={{ twilio_whatsapp_from | default('') }}
PUSH_WEBHOOK_URL={{ push_webhook_url | default('') }}
PAGE_ACK_TIMEOUT_SECONDS={{ page_ack_timeout_seconds | default(600) }}
MANAGED_HEARTBEAT_STALE_MINUTES={{ managed_heartbeat_stale_minutes | default(10) }}
MAINTENANCE_RUNNER={{ maintenance_runner | default('fake') }}
MAINTENANCE_PLAYBOOK_DIR={{ maintenance_playbook_dir | default('/opt/prgd/maintenance') }}
MAINTENANCE_SSH_USER={{ maintenance_ssh_user | default('prgd') }}
MAINTENANCE_SSH_KEY_FILE={{ maintenance_ssh_key_file | default('') }}
MAINTENANCE_TIMEOUT_MINUTES={{ maintenance_timeout_minutes | default(60) }}
MANAGED_REPORT_AUTOSEND_DAY={{ managed_report_autosend_day | default(3) }}

# DevOps console: ops sign in, access grants, SSH certificates, the terminal gateway, secrets (docs/devops-console.md)
PRGD_OPS_URL={{ prgd_ops_url | default('https://ops.progrid.sa') }}
PRGD_OPS_RP_ID={{ prgd_ops_rp_id | default('ops.progrid.sa') }}
PRGD_OPS_RP_NAME={{ prgd_ops_rp_name | default('Progrid Ops') }}
PRGD_OPS_SESSION_TTL_SECONDS={{ prgd_ops_session_ttl_seconds | default(43200) }}
PRGD_GRAFANA_URL={{ prgd_grafana_url | default('') }}
PRGD_OPS_TIMER_IDLE_PROMPT_SECONDS={{ prgd_ops_timer_idle_prompt_seconds | default(3600) }}
PRGD_OPS_TIMER_AUTO_STOP_SECONDS={{ prgd_ops_timer_auto_stop_seconds | default(5400) }}
PRGD_SSH_CA={{ prgd_ssh_ca | default('step-ca') }}
PRGD_STEPCA_URL={{ prgd_stepca_url | default('') }}
PRGD_STEPCA_PROVISIONER={{ prgd_stepca_provisioner | default('prgd-gateway') }}
PRGD_STEPCA_JWK={{ vault_prgd_stepca_jwk | default('') }}
PRGD_STEPCA_PASSWORD={{ vault_prgd_stepca_password | default('') }}
PRGD_STEPCA_ROOT_FINGERPRINT={{ prgd_stepca_root_fingerprint | default('') }}
PRGD_SSH_LOGIN_USER={{ prgd_ssh_login_user | default('prgd') }}
PRGD_SSH_PORT={{ prgd_ssh_port | default(22) }}
PRGD_PLATFORM_HEARTBEAT_SECRET={{ vault_prgd_platform_heartbeat_secret | default('') }}
PRGD_PLATFORM_HOSTNAMES={{ prgd_platform_hostnames | default('') }}
PRGD_PLATFORM_EXPECTED_PORTS={{ prgd_platform_expected_ports | default('22,80,443') }}
PRGD_GATEWAY_SECRET={{ vault_prgd_gateway_secret | default('') }}
PRGD_GATEWAY_PUBLIC_URL={{ prgd_gateway_public_url | default('wss://gateway.progrid.sa') }}
PRGD_GATEWAY_TOKEN_TTL_SECONDS={{ prgd_gateway_token_ttl_seconds | default(60) }}
PRGD_GATEWAY_SOURCE_ADDRESSES={{ prgd_gateway_source_addresses | default('') }}
PRGD_GATEWAY_ID={{ prgd_gateway_id | default('gw-1') }}
PRGD_GATEWAY_ALLOWED_ORIGINS={{ prgd_gateway_allowed_origins | default('https://ops.' ~ domain) }}
PRGD_GATEWAY_KNOWN_HOSTS={{ '/etc/prgd-gateway/known_hosts' if prgd_gateway_known_hosts is defined else '' }}
PRGD_GATEWAY_MAX_SESSIONS={{ prgd_gateway_max_sessions | default(50) }}
PRGD_RECORDINGS_BUCKET={{ prgd_recordings_bucket | default('prgd-session-recordings') }}
PRGD_SECRET_STORE={{ prgd_secret_store | default('vault') }}
PRGD_VAULT_ADDR={{ prgd_vault_addr | default('') }}
PRGD_VAULT_TOKEN={{ vault_prgd_vault_token | default('') }}
PRGD_VAULT_MOUNT={{ prgd_vault_mount | default('prgd') }}
PRGD_INFISICAL_URL={{ prgd_infisical_url | default('https://app.infisical.com') }}
PRGD_INFISICAL_TOKEN={{ vault_prgd_infisical_token | default('') }}
PRGD_INFISICAL_PROJECT={{ prgd_infisical_project | default('') }}
PRGD_INFISICAL_ENV={{ prgd_infisical_env | default('prod') }}
# Social sign in with Google and Microsoft (docs/social-sign-in.md)
GOOGLE_CLIENT_ID={{ google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret | default('') }}
MICROSOFT_CLIENT_ID={{ microsoft_client_id | default('') }}
MICROSOFT_CLIENT_SECRET={{ vault_microsoft_client_secret | default('') }}
MICROSOFT_TENANT={{ microsoft_tenant | default('common') }}
OAUTH_REDIRECT_BASE=https://api.{{ domain }}
# Progrid Connect (docs/connect.md); without an Anthropic key agents run on the fake model
ANTHROPIC_API_KEY={{ vault_anthropic_api_key | default('') }}
CONNECT_MODEL_PROVIDER={{ connect_model_provider | default('') }}
CONNECT_DEFAULT_MODEL={{ connect_default_model | default('claude-opus-5-5') }}
CONNECT_MODEL_FALLBACKS={{ connect_model_fallbacks | default('true') }}
CONNECT_MAX_OUTPUT_TOKENS={{ connect_max_output_tokens | default(16000) }}
CONNECT_PUBLIC_BASE_URL=https://api.{{ domain }}
CONNECT_MAX_AGENTS_PER_TEAM={{ connect_max_agents_per_team | default(50) }}
CONNECT_MAX_CONNECTIONS_PER_TEAM={{ connect_max_connections_per_team | default(50) }}
CONNECT_MAX_CONCURRENT_RUNS={{ connect_max_concurrent_runs | default(10) }}
CONNECT_RUNS_PER_MINUTE_PER_AGENT={{ connect_runs_per_minute_per_agent | default(60) }}
CONNECT_RUNS_PER_MINUTE_PER_TEAM={{ connect_runs_per_minute_per_team | default(300) }}
CONNECT_PLATFORM_EMAILS_PER_HOUR={{ connect_platform_emails_per_hour | default(50) }}
CONNECT_NETWORK_ALLOWLIST={{ connect_network_allowlist | default('') }}
CONNECT_SYNC_TIMEOUT_SECONDS={{ connect_sync_timeout_seconds | default(60) }}
