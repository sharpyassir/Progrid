# Managed by Ansible (role baseline). Kernel and network hardening.
# IP forwarding is deliberately left alone: Docker (management) and the routed public blocks
# (Proxmox nodes, docs/first-proxmox-node.md step 15) need it.

# Reverse path filtering: strict (1) on the management host, loose (2) on Proxmox nodes, where
# strict mode drops bridged, routed and VXLAN traffic that arrives on another interface.
net.ipv4.conf.all.rp_filter = {{ baseline_rp_filter }}
net.ipv4.conf.default.rp_filter = {{ baseline_rp_filter }}

# No ICMP redirects in either direction, no source routed packets.
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0

# SYN flood protection.
net.ipv4.tcp_syncookies = 1

# Kernel pointers and the kernel log only for root.
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1

# No hard or symbolic link tricks in world writable directories, no core dumps of setuid programs.
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.suid_dumpable = 0

# Unprivileged users cannot load BPF programs. 1 is sticky until the next reboot.
kernel.unprivileged_bpf_disabled = 1
