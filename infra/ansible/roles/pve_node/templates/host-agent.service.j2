[Unit]
Description=prgd host agent (Proxmox node {{ pve_node_name }})
After=network-online.target pve-cluster.service pveproxy.service wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
ExecStart=/usr/local/bin/host-agent -config /etc/prgd/agent.yaml
EnvironmentFile=/etc/prgd/agent.env
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
ProtectSystem=full
# lvextend (storage_type lvmthin) writes its metadata backups here
ReadWritePaths=-/etc/lvm
ProtectHome=true

[Install]
WantedBy=multi-user.target
