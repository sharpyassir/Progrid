# Copy to group_vars/all/vars.yml. Secrets go in group_vars/all/vault.yml (ansible-vault) with the vault_ prefix.
# Both files must sit in the group_vars/all directory so Ansible applies them to every host.
domain: progrid.sa
acme_email: support@progrid.sa
registry: ghcr.io/sharpyassir
image_tag: latest
host_agent_version: v0.1.0          # GitHub release tag that carries host-agent_linux_amd64.tar.gz
hypervisor_driver: proxmox          # fake for a demo box without Proxmox
proxmox_url: https://pve1.mgmt.internal:8006
proxmox_token_id: prgd@pve!control-plane
proxmox_ceph_pool: vm-disks
proxmox_vxlan_zone: customers
mail_provider: postmark
mail_from: "Progrid <no-reply@progrid.sa>"
support_inbox: support@progrid.sa
require_totp_for_owners: true
fx_usd_sar: 3.75
backup_keep_days: 14
backup_s3_url: ""
ssh_allow_from: []                  # CIDRs allowed to reach 22; empty means anywhere
control_plane_cidr: 10.0.0.0/12     # management network that may reach platform agents; must not overlap the tenant pool (10.96.0.0/12)
company_name: Progrid Arabia
company_address: "Riyadh, Kingdom of Saudi Arabia"
company_tax_id: ""                  # VAT registration number, printed on invoices
payment_provider: moyasar           # fake only on a demo box; it hands out free credit
dns_provider: powerdns              # fake only on a demo box
dns_nameservers: ns1.progrid.sa,ns2.progrid.sa
object_storage_provider: rgw        # fake only on a demo box
s3_endpoint: https://s3.sa1.progrid.sa
# Managed cloud
paging_mode: live                   # log records pages without sending them
twilio_account_sid: ""
twilio_from: ""                     # E.164 SMS sender
twilio_whatsapp_from: ""            # E.164 WhatsApp sender
push_webhook_url: ""
page_ack_timeout_seconds: 600
maintenance_runner: fake            # ansible once the worker can reach the management network
maintenance_playbook_dir: /opt/prgd/maintenance
maintenance_ssh_user: prgd
maintenance_ssh_key_file: ""
# DevOps console (docs/devops-console.md)
prgd_ops_url: https://ops.progrid.sa
prgd_ops_rp_id: ops.progrid.sa
prgd_grafana_url: https://grafana.progrid.sa
prgd_ssh_ca: step-ca                # local keeps the CA key in the database: development only
prgd_stepca_url: https://ca.internal.progrid.sa:9000
prgd_stepca_provisioner: prgd-gateway
prgd_stepca_root_fingerprint: ""
prgd_ssh_login_user: prgd
prgd_gateway_public_url: wss://gateway.progrid.sa
prgd_gateway_source_addresses: ""   # the gateway's management network address, e.g. 10.8.0.2/32
prgd_recordings_bucket: prgd-session-recordings
prgd_secret_store: vault            # vault | infisical
prgd_vault_addr: https://vault.internal.progrid.sa:8200
prgd_vault_mount: prgd
prgd_infisical_project: ""

# --- vault.yml keys (values with ansible-vault) ---
# vault_postgres_password: ...
# vault_nats_token: ...
# vault_jwt_secret: ...
# vault_secrets_key: ...            # encrypts TOTP seeds and webhook secrets at rest
# vault_proxmox_token_secret: ...
# vault_mail_api_key: ...
# vault_moyasar_secret_key: ...
# vault_moyasar_webhook_secret: ...
# vault_support_inbound_secret: ...
# vault_alertmanager_webhook_secret: ...  # shared secret for POST /internal/alerts/alertmanager
# vault_twilio_auth_token: ""             # Twilio SMS and WhatsApp paging
# vault_prgd_gateway_secret: ...          # shared secret prgd-gateway sends to /internal/gateway
# vault_prgd_stepca_jwk: ...              # step-ca provisioner key (encrypted key from ca.json)
# vault_prgd_stepca_password: ...         # decrypts it
# vault_prgd_vault_token: ...             # Vault token with read and write on the prgd KV v2 mount
# vault_prgd_infisical_token: ""          # Infisical machine identity token, when prgd_secret_store is infisical
# vault_pdns_api_key: ...
# vault_rgw_admin_access_key: ...
# vault_rgw_admin_secret_key: ...
# vault_pve_agent_token_secret: ...
# vault_backup_s3_key: ""
# vault_backup_s3_secret: ""
# vault_ghcr_user: ""               # only when images are private
# vault_ghcr_token: ""
