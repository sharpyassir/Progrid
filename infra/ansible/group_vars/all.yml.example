# Copy to group_vars/all/vars.yml. Secrets go in group_vars/all/vault.yml (ansible-vault) with the vault_ prefix.
# Both files must sit in the group_vars/all directory so Ansible applies them to every host.
# Two domains on one platform (docs/domains-and-entities.md). domain is the primary, global one;
# domain_sa serves the same console, API, ops console and gateway for customers in Saudi Arabia.
# Caddy gets certificates for both, so create the DNS records of both before the first run.
domain: progrid.co
domain_sa: progrid.sa
acme_email: hostmaster@progrid.co
registry: ghcr.io/sharpyassir
image_tag: latest
hypervisor_driver: proxmox          # fake for a demo box without Proxmox
# The control plane never calls Proxmox itself (every call is a NATS job to the host agent), so
# proxmox_url and proxmox_token_id are informational; point them at the first node over WireGuard.
proxmox_url: https://10.9.0.2:8006
proxmox_token_id: prgd@pve!agent
# Host agent (role pve_node). The binary is built from this checkout on the Ansible machine.
proxmox_storage: vm-disks           # storage id for VM disks and volumes
proxmox_storage_type: rbd           # rbd (Ceph cluster) or lvmthin (single node, docs/first-proxmox-node.md)
proxmox_ceph_pool: vm-disks         # rbd only
proxmox_private_bridge: customers   # shared private bridge on every node (PRIVATE_NETWORK_MODE=shared_bridge)
proxmox_public_bridge: vmbr0        # routed bridge that carries the public IP blocks
proxmox_vxlan_zone: tenants         # SDN zone for sdn_vnet mode; Proxmox zone ids are at most 8 characters
# Private networks: sdn_vnet gives each project its own VXLAN VNet (isolation between customers);
# shared_bridge puts every project on proxmox_private_bridge. New installs use sdn_vnet. A host
# whose vars.yml has no private_network_mode keeps shared_bridge (prgd.env.j2 default).
private_network_mode: sdn_vnet
# Management network (role wireguard); addresses per host in the inventory
wireguard_cidr: 10.9.0.0/24         # inside control_plane_cidr, clear of the tenant pool and the DO VPC
wireguard_port: 51820
mail_provider: resend
mail_from: "Progrid <no-reply@progrid.co>"   # staff and system mail; customers get their billing company's sender
support_inbox: support@progrid.co            # staff inbox; support@progrid.sa is accepted too
require_totp_for_owners: true
fx_usd_sar: 3.75
backup_keep_days: 14
backup_s3_url: ""
# age public key (age1...) of the backup key pair. Generate it off the server (age-keygen) and keep
# the private key off the server; empty leaves the dumps unencrypted.
backup_age_recipient: ""
# Security baseline (role baseline, docs/security/infra-hardening.md)
ssh_allow_from: []                  # CIDRs allowed to reach 22 besides wireguard_cidr; empty means anywhere (warns)
ssh_permit_root_login: prohibit-password   # root by key only; Proxmox clustering needs it
unattended_upgrades_reboot: false   # security updates install daily; reboots stay manual
# admin_allow_cidrs: ["198.51.100.7/32"]   # /admin/* and /docs on the api hosts only from these; unset allows all
# Deploy user for the GitHub workflow (DEPLOY_USER=deploy). Its key can only run deploy.sh.
deploy_user: deploy
# deploy_authorized_key: "ssh-ed25519 AAAA... github-deploy"
legacy_ci_deploy_user: true         # false once DEPLOY_USER is the deploy user
pve_manage_cluster_firewall: false  # true writes /etc/pve/firewall/cluster.fw (read the doc first)
# compose_env_overrides: { BACKEND_SUBNET: 172.29.10.0/24, POSTGRES_MEM_LIMIT: 2g }   # docker-compose.yml knobs
control_plane_cidr: 10.0.0.0/12     # management network that may reach platform agents; must not overlap the tenant pool (10.96.0.0/12)
company_name: Progrid                # brand on PDFs and mails
# Billing companies. Leave a value empty until the owner provides it: invoices print a placeholder.
entity_arabia_legal_name: Progrid Arabia
entity_arabia_address: "Riyadh, Kingdom of Saudi Arabia"
entity_arabia_cr: ""                # commercial registration number
entity_arabia_vat_number: ""        # 15 digit VAT registration number
entity_arabia_bank_details: ""
payment_provider: moyasar           # Progrid Arabia, SAR and USD; fake only on a demo box, it hands out free credit
dns_provider: powerdns              # fake only on a demo box
dns_nameservers: ns1.progrid.sa,ns2.progrid.sa
object_storage_provider: rgw        # fake only on a demo box
s3_endpoint: https://s3.sa1.progrid.sa   # platform endpoint; unchanged by the second domain
# Managed cloud
paging_mode: live                   # log records pages without sending them
twilio_account_sid: ""
twilio_from: ""                     # E.164 SMS sender
twilio_whatsapp_from: ""            # E.164 WhatsApp sender
push_webhook_url: ""
page_ack_timeout_seconds: 600
maintenance_runner: fake            # ansible once the worker can reach the management network
maintenance_playbook_dir: /opt/prgd/maintenance
maintenance_ssh_user: prgd
maintenance_ssh_key_file: ""
# DevOps console (docs/devops-console.md)
prgd_ops_url: https://ops.progrid.co     # primary ops console; staff register passkeys here
prgd_ops_rp_id: ops.progrid.co
prgd_ops_url_sa: https://ops.progrid.sa  # same app on the Saudi domain; passkeys from .co do not work here
prgd_ops_rp_id_sa: ops.progrid.sa
prgd_grafana_url: https://grafana.progrid.sa
prgd_ssh_ca: step-ca                # local keeps the CA key in the database: development only
prgd_stepca_url: https://ca.internal.progrid.sa:9000
prgd_stepca_provisioner: prgd-gateway
prgd_stepca_root_fingerprint: ""
prgd_ssh_login_user: prgd
prgd_gateway_public_url: wss://gateway.progrid.co   # sessions opened from ops.progrid.sa use gateway.progrid.sa
prgd_gateway_source_addresses: ""   # the gateway's management network address: the management host's WireGuard address, 10.9.0.1/32
prgd_recordings_bucket: prgd-session-recordings
prgd_secret_store: vault            # vault | infisical
prgd_vault_addr: https://vault.internal.progrid.sa:8200
prgd_vault_mount: prgd
prgd_infisical_project: ""
# Social sign in (docs/social-sign-in.md); leave a client id empty to hide that button
google_client_id: ""                # xxxx.apps.googleusercontent.com; add the redirect URI of both api hosts
microsoft_client_id: ""             # Application (client) ID from the Entra app registration
microsoft_tenant: common            # common accepts work, school and personal accounts
# Progrid Connect (docs/connect.md); the Anthropic key lives in vault.yml as vault_anthropic_api_key
connect_default_model: claude-opus-5-5   # also claude-sonnet-5-5, claude-haiku-4-5
connect_model_fallbacks: "true"          # server side refusal fallbacks on Opus requests
connect_max_concurrent_runs: 10          # per team
connect_network_allowlist: ""            # admin only: private CIDRs or hosts agent tools may reach

# --- vault.yml keys (values with ansible-vault) ---
# vault_postgres_password: ...
# vault_nats_token: ...
# vault_jwt_secret: ...
# vault_secrets_key: ...            # encrypts TOTP seeds and webhook secrets at rest
# vault_secrets_keys: ...           # optional key ring "kid:key,kid:key", active first (key-management.md)
# vault_secrets_legacy_key: ...     # only if data was sealed while SECRETS_KEY was empty (= old JWT_SECRET)
# vault_redis_password: ""           # openssl rand -hex 32; empty runs Redis without AUTH
# vault_proxmox_token_secret: ""       # unused: the control plane has no Proxmox token (the agent's lives on the node)
# vault_mail_api_key: ...
# vault_moyasar_secret_key: ...
# vault_moyasar_webhook_secret: ...
# Stripe is not used (the US Stripe account belonged to Progrid Technologies LLC); no vault_stripe_* needed.
# vault_support_inbound_secret: ...
# vault_resend_webhook_secret: ""       # Resend webhook signing secret (whsec_...) for inbound support mail
# vault_alertmanager_webhook_secret: ...  # shared secret for POST /internal/alerts/alertmanager
# vault_twilio_auth_token: ""             # Twilio SMS and WhatsApp paging
# vault_prgd_gateway_secret: ...          # shared secret prgd-gateway sends to /internal/gateway
# vault_prgd_stepca_jwk: ...              # step-ca provisioner key (encrypted key from ca.json)
# vault_prgd_stepca_password: ...         # decrypts it
# vault_prgd_vault_token: ...             # Vault token with read and write on the prgd KV v2 mount
# vault_prgd_infisical_token: ""          # Infisical machine identity token, when prgd_secret_store is infisical
# vault_google_client_secret: ""          # social sign in with Google
# vault_microsoft_client_secret: ""       # social sign in with Microsoft; rotate before it expires
# vault_anthropic_api_key: ""             # Claude API key for Progrid Connect agents; empty runs the fake model
# vault_pdns_api_key: ...
# vault_rgw_admin_access_key: ...
# vault_rgw_admin_secret_key: ...
# vault_backup_s3_key: ""
# vault_backup_s3_secret: ""
# vault_ghcr_user: ""               # only when images are private
# vault_ghcr_token: ""
