# --- control plane (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://prgd:prgd@localhost:5432/prgd
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# fake | proxmox   (fake = provision in-memory VMs, no data plane needed)
HYPERVISOR_DRIVER=fake

# Proxmox (only when HYPERVISOR_DRIVER=proxmox)
PROXMOX_URL=https://pve1.sa1.internal:8006
PROXMOX_TOKEN_ID=prgd@pve!control-plane
PROXMOX_TOKEN_SECRET=
PROXMOX_CEPH_POOL=vm-disks
PROXMOX_VXLAN_ZONE=customers

# Auth
# Encrypts TOTP seeds and webhook secrets at rest; falls back to JWT_SECRET when empty
SECRETS_KEY=
JWT_SECRET=change-me-in-production
SESSION_TTL_SECONDS=86400
# Staff must use two factor sign in before any back office call
REQUIRE_TOTP_FOR_STAFF=true
REQUIRE_TOTP_FOR_OWNERS=false        # true in production: owners must enable two factor sign in
CONSOLE_URL=http://localhost:3000    # used in verification and reset links
PUBLIC_API_URL=http://localhost:4000 # what GitHub and customers reach; used in webhook URLs

# GitHub App for Git Deploy (optional). Create it at github.com/settings/apps with
# permissions Contents: read, Metadata: read; events: push, installation; webhook URL
# $PUBLIC_API_URL/v1/github/webhook; setup URL $CONSOLE_URL/github/callback (redirect on update: on).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=              # PEM contents, newlines as \n
GITHUB_APP_WEBHOOK_SECRET=

# Mail: log | postmark | resend
MAIL_PROVIDER=log
MAIL_FROM="Progrid <no-reply@progrid.sa>"
# Where new support tickets and customer replies are mailed; empty disables
SUPPORT_INBOX=support@progrid.sa
# Shared secret for the inbound email webhook (POST /v1/support/inbound); empty disables email intake
SUPPORT_INBOUND_SECRET=
MAIL_API_KEY=

# Card payments: fake (built in test page) | moyasar for SAR and USD
PAYMENT_PROVIDER=fake
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# Seller details on invoice PDFs
COMPANY_NAME=Progrid
COMPANY_ADDRESS=Saudi Arabia
COMPANY_TAX_ID=

# Billing: every price is in USD; riyals are converted at the stored USD→SAR rate
BILLING_HOURS_PER_MONTH=672
DEFAULT_CURRENCY=USD
FX_USD_SAR=3.75                       # fallback until the first rate is fetched or set
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# --- managed cloud (docs/managed-cloud-operations.md) ---
# Shared secret Alertmanager sends as a Bearer token or X-Prgd-Webhook-Secret; empty refuses every call
ALERTMANAGER_WEBHOOK_SECRET=
# log records pages without sending them; live sends SMS, WhatsApp, push or email
PAGING_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # E.164 sender for SMS pages, e.g. +15005550006
TWILIO_WHATSAPP_FROM=                 # E.164 WhatsApp sender
PUSH_WEBHOOK_URL=                     # generic push relay; receives JSON {pageId, userId, email, urgency, title, message, url}
PAGE_ACK_TIMEOUT_SECONDS=600          # page the support lead when the on call engineer has not acknowledged
MANAGED_HEARTBEAT_STALE_MINUTES=10    # external servers silent this long are unhealthy and raise an alert
MAINTENANCE_RUNNER=fake               # fake | ansible
MAINTENANCE_PLAYBOOK_DIR=infra/ansible/maintenance
MAINTENANCE_SSH_USER=prgd
MAINTENANCE_SSH_KEY_FILE=
MAINTENANCE_TIMEOUT_MINUTES=60
MANAGED_REPORT_AUTOSEND_DAY=3         # unsent monthly report drafts go out on this day

# --- DevOps console (docs/devops-console.md) ---
PRGD_OPS_URL=http://localhost:3002    # the ops console app (apps/ops); also the WebAuthn origin
PRGD_OPS_RP_ID=localhost              # WebAuthn relying party id: ops.progrid.sa or progrid.sa in production
PRGD_OPS_RP_NAME=Progrid Ops
PRGD_OPS_SESSION_TTL_SECONDS=43200    # ops console sessions last twelve hours
PRGD_GRAFANA_URL=                     # asset view metric and log links; empty hides them
PRGD_OPS_TIMER_IDLE_PROMPT_SECONDS=3600  # default of the ops settings: idle prompt ...
PRGD_OPS_TIMER_AUTO_STOP_SECONDS=5400    # ... and automatic stop of a work timer
PRGD_SSH_CA=local                     # local (key in the database) | step-ca
PRGD_STEPCA_URL=
PRGD_STEPCA_PROVISIONER=
PRGD_STEPCA_JWK=                      # provisioner private JWK (JSON), or its encrypted key from ca.json with the password
PRGD_STEPCA_PASSWORD=
PRGD_STEPCA_ROOT_FINGERPRINT=
PRGD_SSH_LOGIN_USER=prgd              # user the gateway logs in as on assets
PRGD_SSH_PORT=22
PRGD_GATEWAY_SECRET=dev-gateway-secret   # prgd-gateway sends it as X-Prgd-Gateway-Secret; empty refuses every call
PRGD_GATEWAY_PUBLIC_URL=ws://localhost:4100
PRGD_GATEWAY_TOKEN_TTL_SECONDS=60
PRGD_GATEWAY_SOURCE_ADDRESSES=        # CIDRs the gateway reaches assets from; pins certificates to them when set
PRGD_RECORDINGS_BUCKET=prgd-session-recordings
PRGD_SECRET_STORE=local               # local | vault | infisical
PRGD_VAULT_ADDR=
PRGD_VAULT_TOKEN=
PRGD_VAULT_MOUNT=prgd
PRGD_INFISICAL_URL=https://app.infisical.com
PRGD_INFISICAL_TOKEN=
PRGD_INFISICAL_PROJECT=
PRGD_INFISICAL_ENV=prod
# --- social sign in (docs/social-sign-in.md); a provider appears in the console once its id and secret are set ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common               # common accepts work, school and personal Microsoft accounts
OAUTH_REDIRECT_BASE=                  # empty uses PUBLIC_API_URL; redirect URI is <base>/v1/auth/oauth/<provider>/callback

# --- console (apps/console) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
