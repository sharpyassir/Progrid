{
  "name": "@prgd/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the prgd API. Types are generated from the OpenAPI specification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen": "openapi-typescript ../openapi/openapi.yaml -o src/types.gen.ts",
    "build": "pnpm gen && tsc -p tsconfig.json",
    "typecheck": "pnpm gen && tsc --noEmit -p tsconfig.json",
    "test": "pnpm gen && tsc --noEmit -p tsconfig.json && node --test --import tsx src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "openapi-typescript": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
