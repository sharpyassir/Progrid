// prgd control plane data model.
// Models are grouped by owning module (see docs/adr/0001-modular-monolith.md).
// Money is always integer minor units (cents / kuruş). Time is always UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── IAM ─────────────────────────

enum TeamRole {
  owner
  admin
  member
  billing
  readonly
}

enum Currency {
  USD
  SAR
}

enum AccountStatus {
  active
  pending_verification
  suspended
  closed
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  locale        String    @default("en") // en | tr | ar
  totpSecret    String? // 2FA (mandatory for owners)
  totpEnabled   Boolean   @default(false)
  /// sha256 of unused one time recovery codes
  totpRecoveryHashes String[] @default([])
  /// Staff members may hold the `admin` scope (back-office). Never settable via the API.
  isStaff       Boolean   @default(false)
  /// Empty means full back office access. Otherwise a subset of support, finance, ops.
  staffRoles    String[]  @default([])
  sessions      Session[]
  emailVerified DateTime?
  phoneVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships TeamMember[]
  sshKeys     SshKey[]
  apiTokens   ApiToken[]
  auditLogs   AuditLog[]
  emailTokens EmailToken[]
  decidedApprovals Approval[]
}

/// One time links for email verification and password reset (hash stored, raw token mailed).
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // verify | reset
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Team {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  currency Currency      @default(USD)
  country  String        @default("SA") // ISO 3166-1; drives SAR billing, ZATCA e-invoicing and PDPL residency
  status   AccountStatus @default(pending_verification)
  /// Why the team is suspended. "billing: ..." is lifted automatically once the overdue invoices are settled.
  suspensionReason String?
  suspendedAt      DateTime?
  taxId    String? // buyer VAT number, printed on invoices
  /// Invoices and payment reminders also go here. Printed on invoices with the address.
  billingEmail   String?
  billingAddress String?
  closedAt       DateTime?
  // Trust & safety
  kycLevel   Int      @default(0) // 0 none, 1 phone, 2 ID, 3 business
  riskScore  Int      @default(0)
  /// Support plan; billed monthly against the team's default project.
  supportPlan      SupportPlan @default(free)
  supportPlanSince DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members   TeamMember[]
  invitations Invitation[]
  projects  Project[]
  apiTokens ApiToken[]
  approvals Approval[]
  githubInstallations GithubInstallation[]
  alertPolicies AlertPolicy[]
  invoices  Invoice[]
  credits   Credit[]
  payments  Payment[]
  creditNotes CreditNote[]
  abuseFlags AbuseFlag[]
  webhooks  Webhook[]
}

model TeamMember {
  teamId String
  userId String
  role   TeamRole @default(member)
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

/// An emailed invitation to join a team. The link carries a random token; only its hash is stored.
model Invitation {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  role       TeamRole  @default(member)
  tokenHash  String    @unique
  invitedBy  String // userId
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String? // userId
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

model Project {
  id     String @id @default(cuid())
  teamId String
  slug   String
  name   String
  // Quotas & spend controls
  quotaServers    Int  @default(10)
  quotaVcpu       Int  @default(32)
  quotaMemoryMb   Int  @default(65536)
  quotaPublicIps  Int  @default(10)
  spendLimitMinor Int? // hard monthly cap; null = unlimited
  spendAlertMinor Int? // email/SMS alert threshold
  createdAt DateTime @default(now())

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  servers   Server[]
  publicIps PublicIp[]
  firewalls Firewall[]
  snapshots Snapshot[]
  volumes   Volume[]
  loadBalancers LoadBalancer[]
  certificates  Certificate[]
  dnsZones      DnsZone[]
  buckets       Bucket[]
  storageKeys   StorageKey[]
  dbClusters    DbCluster[]
  kubeClusters  KubeCluster[]
  platformApps  PlatformApp[]
  apiTokens ApiToken[]
  usage     UsageRecord[]
  deployments Deployment[]
  privateNetworks PrivateNetwork[]

  @@unique([teamId, slug])
}

model SshKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  publicKey   String
  fingerprint String   @unique
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// API tokens for humans *and* AI agents. Agent-safe tokens carry scopes, a spend cap
/// and can require human approval for destructive actions (phase 2 enforces approval).
model ApiToken {
  id          String    @id @default(cuid())
  teamId      String
  userId      String
  projectId   String? // null = all projects in team
  name        String
  prefix      String // first 8 chars, shown in UI
  hash        String    @unique // sha256 of full token
  scopes      String[] // e.g. ["servers:read","servers:write","billing:read"]
  isAgent     Boolean   @default(false)
  spendCapMinor       Int? // hard cap for this token per month
  spentThisMonthMinor Int       @default(0)
  requireApprovalFor  String[]  @default([]) // ["servers:delete","servers:resize-down"]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals Approval[]
}

enum ApprovalStatus {
  pending
  approved
  denied
  expired
  failed
}

/// A request from an agent token that a person must approve before it runs.
model Approval {
  id            String         @id @default(cuid())
  teamId        String
  projectId     String
  tokenId       String?
  requestedById String
  kind          String // "servers:delete" | "servers:resize-down" | "servers:create" ...
  resourceType  String
  resourceId    String?
  resourceName  String?
  summary       String
  payload       Json           @default("{}")
  status        ApprovalStatus @default(pending)
  result        Json?
  reason        String?
  decidedById   String?
  decidedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime       @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  token     ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  decidedBy User?     @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
  @@index([tokenId, status])
}

// ───────────────────────── Regions & data plane inventory ─────────────────────────

model Region {
  id        String  @id // "sa1"
  name      String // "Saudi Arabia 1"
  country   String // "SA"
  available Boolean @default(true)
  hosts     Host[]
  servers   Server[]
  publicIps PublicIp[]
  ipBlocks  IpBlock[]
  images    Image[]
  volumes   Volume[]
  loadBalancers LoadBalancer[]
  buckets   Bucket[]
  dbClusters DbCluster[]
  kubeClusters KubeCluster[]
  platformApps PlatformApp[]
  appHosts     AppHost[]
  privateNetworks PrivateNetwork[]
}

enum HostStatus {
  active
  draining // no new placements
  maintenance
  down
}

/// A physical Proxmox node. Capacity is tracked in the control plane for scheduling;
/// the host agent refreshes it every minute.
model Host {
  id         String     @id @default(cuid())
  regionId   String
  name       String     @unique // "pve1"
  driver     String     @default("proxmox")
  driverRef  String // opaque: {"node":"pve1"} for Proxmox
  status     HostStatus @default(active)
  totalVcpu  Int
  totalMemoryMb Int
  totalDiskGb   Int
  usedVcpu   Int        @default(0)
  usedMemoryMb  Int     @default(0)
  usedDiskGb    Int     @default(0)
  overcommitCpu Float   @default(4.0) // vCPU overcommit ratio
  labels     Json       @default("{}")
  lastHeartbeatAt DateTime?
  createdAt  DateTime   @default(now())

  region  Region   @relation(fields: [regionId], references: [id])
  servers Server[]
}

// ───────────────────────── Compute ─────────────────────────

enum ServerStatus {
  new
  provisioning
  active
  off
  rebooting
  resizing
  rebuilding
  deleting
  deleted
  failed
  suspended // trust & safety or unpaid
}

model Size {
  id        String  @id // "s-2vcpu-4gb"
  name      String  @default("") // "Starter", "Standard", "Pro", "Business"
  vcpu      Int
  memoryMb  Int
  diskGb    Int
  transferTb Float
  family    String  @default("shared") // shared | dedicated | gpu
  gpuCount  Int     @default(0)
  available Boolean @default(true)
  sortOrder Int     @default(0)
  servers   Server[]
  prices    Price[]
  dbClusters DbCluster[]
  kubeControl  KubeCluster[]  @relation("KubeControlSize")
  kubePools    KubeNodePool[] @relation("KubePoolSize")
}

enum ImageKind {
  distribution
  marketplace
  snapshot
  custom
}

model Image {
  id           String    @id // "ubuntu-24-04", "app-wordpress-6"
  regionId     String? // null = all regions
  kind         ImageKind
  name         String
  distribution String? // "ubuntu"
  version      String? // "24.04"
  driverRef    String? // opaque: {"template":9001} (Proxmox template VMID)
  minDiskGb    Int       @default(10)
  minMemoryMb  Int       @default(512)
  public       Boolean   @default(true)
  deprecated   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  region  Region?  @relation(fields: [regionId], references: [id])
  servers Server[]
  app     MarketplaceApp?
}

model Server {
  id        String       @id @default(cuid())
  projectId String
  regionId  String
  hostId    String?
  sizeId    String
  imageId   String
  name      String
  status    ServerStatus @default(new)
  statusMessage String?
  driverRef String? // opaque: {"vmid":1234,"node":"pve1"}
  vcpu      Int
  memoryMb  Int
  diskGb    Int
  privateIp String?
  userData  String? // cloud-init user-data
  /// Set when the server was created from a snapshot: the VM clones that snapshot instead of the image.
  sourceSnapshotId String?
  sshKeyIds String[]     @default([])
  tags      String[]     @default([])
  backupsEnabled Boolean @default(false)
  /// Managed tier: the in VM care agent keeps the system patched, hardened and watched.
  managed          Boolean   @default(false)
  managedToken     String?   @unique
  managedReport    Json?
  managedReportedAt DateTime?
  managedHealth    String? // ok | warn | stale | pending
  /// Set for platform owned VMs ("lb:<id>"): hidden from the server list, not deletable directly.
  managedBy String?
  meteredSince   DateTime? // billing starts here, never before VM is running
  /// Powered off because the team was suspended; reinstating the team powers it back on.
  suspendedPoweredOff Boolean @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id])
  region    Region     @relation(fields: [regionId], references: [id])
  host      Host?      @relation(fields: [hostId], references: [id])
  size      Size       @relation(fields: [sizeId], references: [id])
  image     Image      @relation(fields: [imageId], references: [id])
  publicIps PublicIp[]
  /// The address reserved on the project's private network (net0). Null for servers created before allocation existed.
  privateIpAlloc PrivateIp?
  snapshots Snapshot[]
  firewalls FirewallServer[]
  actions   ServerAction[]
  deployment Deployment?

  @@index([projectId, status])
  @@index([hostId])
  volumes Volume[]
  lbNode    LoadBalancerNode?
  lbTargets LoadBalancerTarget[]

  @@index([managedBy])
  dbNode    DbNode?
  kubeNode  KubeNode?
  appHost   AppHost?
}

enum ActionType {
  create
  start
  stop
  reboot
  resize
  rebuild
  snapshot
  restore
  delete
}

enum ActionStatus {
  queued
  running
  completed
  failed
}

/// Every lifecycle operation is recorded here and backed by a Temporal workflow.
model ServerAction {
  id          String       @id @default(cuid())
  serverId    String
  type        ActionType
  status      ActionStatus @default(queued)
  workflowId  String?      @unique
  params      Json         @default("{}")
  error       String?
  requestedBy String? // userId or apiTokenId
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, startedAt])
}

// ───────────────────────── Storage (MVP: snapshots) ─────────────────────────

enum SnapshotStatus {
  pending
  available
  failed
  deleted
}

enum SnapshotKind {
  manual
  backup
}

model Snapshot {
  id        String         @id @default(cuid())
  projectId String
  serverId  String?
  name      String
  /// backup = taken daily by the platform, kept seven, covered by the backups price
  kind      SnapshotKind   @default(manual)
  status    SnapshotStatus @default(pending)
  sizeGb    Float          @default(0)
  driverRef String?
  createdAt DateTime       @default(now())
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  server  Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([serverId, kind])
}

// ───────────────────────── Networking (MVP: public IPs + firewalls) ─────────────────────────

model IpBlock {
  id        String     @id @default(cuid())
  regionId  String
  cidr      String     @unique // "185.0.0.0/24"
  gateway   String
  owned     Boolean    @default(false) // own RIPE block vs leased
  region    Region     @relation(fields: [regionId], references: [id])
  ips       PublicIp[]
}

enum IpStatus {
  free
  reserved
  assigned
}

model PublicIp {
  id        String   @id @default(cuid())
  regionId  String
  blockId   String
  projectId String?
  serverId  String?
  address   String   @unique
  status    IpStatus @default(free)
  floating  Boolean  @default(false) // reserved independently of a server (phase 2 UX)
  reverseDns String?
  assignedAt DateTime?

  region  Region   @relation(fields: [regionId], references: [id])
  block   IpBlock  @relation(fields: [blockId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  server  Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([status, regionId])
  loadBalancer LoadBalancer?
  /// False while a reverse DNS change waits to reach the nameservers.
  reverseDnsSynced Boolean @default(true)
  dbCluster    DbCluster?
  kubeCluster  KubeCluster?
}

/// A project's private network in one region. Its CIDR comes from the region pool
/// (PRIVATE_NETWORK_POOL); servers of the project in that region get a static address from
/// it on their private NIC (net0). In PRIVATE_NETWORK_MODE=sdn_vnet the network is also a
/// Proxmox SDN VNet in the VXLAN zone, which isolates it from every other project.
model PrivateNetwork {
  id           String    @id @default(cuid())
  projectId    String
  regionId     String
  cidr         String // "10.96.3.0/24"
  /// Index of the CIDR within the region pool; the VXLAN tag and the VNet id derive from it.
  poolIndex    Int
  /// VXLAN network identifier of the VNet.
  vxlanTag     Int
  /// Proxmox SDN VNet id (at most 8 characters), e.g. "pn7ps".
  vnet         String
  /// When the VNet was created and the SDN config applied; null until then (and in shared_bridge mode).
  sdnAppliedAt DateTime?
  createdAt    DateTime  @default(now())

  project Project     @relation(fields: [projectId], references: [id])
  region  Region      @relation(fields: [regionId], references: [id])
  ips     PrivateIp[]

  @@unique([projectId, regionId])
  @@unique([regionId, cidr])
  @@unique([regionId, poolIndex])
}

/// One address on a private network, held by a server from create until delete.
model PrivateIp {
  id        String   @id @default(cuid())
  networkId String
  serverId  String?  @unique
  address   String
  createdAt DateTime @default(now())

  network PrivateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  server  Server?        @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@unique([networkId, address])
}

enum FirewallDirection {
  inbound
  outbound
}

enum FirewallProtocol {
  tcp
  udp
  icmp
  /// IP protocol 112, keepalived between cluster members
  vrrp
  any
}

model Firewall {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id])
  rules   FirewallRule[]
  servers FirewallServer[]
}

model FirewallRule {
  id         String            @id @default(cuid())
  firewallId String
  direction  FirewallDirection
  protocol   FirewallProtocol
  ports      String? // "22", "80-443", null for icmp/any
  sources    String[]          @default([]) // CIDRs for inbound
  destinations String[]        @default([]) // CIDRs for outbound
  description String?

  firewall Firewall @relation(fields: [firewallId], references: [id], onDelete: Cascade)
}

model FirewallServer {
  firewallId String
  serverId   String
  firewall   Firewall @relation(fields: [firewallId], references: [id], onDelete: Cascade)
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([firewallId, serverId])
}

// ───────────────────────── Marketplace ─────────────────────────

enum AppStatus {
  draft
  in_review
  published
  deprecated
}

model MarketplaceApp {
  id          String    @id // "wordpress"
  imageId     String    @unique
  name        String
  slug        String    @unique
  category    String // cms | ecommerce | devtools | ai | automation | ...
  summary     String
  description String
  version     String
  iconUrl     String?
  minSizeId   String
  ports       Int[]     @default([])
  variables   Json      @default("[]") // [{name,label,type,required,default}]
  cloudInit   String // rendered with variables at deploy time
  vendorName  String    @default("prgd")
  vendorRevenueShare Int @default(0) // percent, e.g. 70 for paid vendor apps
  priceMonthlyMinor  Int @default(0) // 0 = free (server cost only)
  status      AppStatus @default(draft)
  repoUrl     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  image Image @relation(fields: [imageId], references: [id])
}

// ───────────────────────── Billing & metering ─────────────────────────

enum ResourceType {
  server
  snapshot
  public_ip
  bandwidth
  volume
  load_balancer
  object_storage
  database
  app
  backup
  managed_server
  support
  kubernetes
  app_instance
}

/// Raw per-minute usage from host agents (TimescaleDB hypertable on `at`, created in
/// migration). Never updated; rolled up into UsageRecord hourly.
model UsageEvent {
  id           BigInt       @default(autoincrement())
  at           DateTime
  resourceType ResourceType
  resourceId   String
  projectId    String
  hostId       String?
  quantity     Float // 1 for server-minute, GB for snapshots, bytes since the previous minute for bandwidth
  unit         String // "minute" | "gb_minute" | "byte"
  meta         Json         @default("{}")

  @@id([id, at])
  @@unique([resourceType, resourceId, at])
  @@index([projectId, at])
}

/// One row per resource per hour, rated.
model UsageRecord {
  id           String       @id @default(cuid())
  projectId    String
  resourceType ResourceType
  resourceId   String
  hourStart    DateTime
  quantity     Float
  unit         String
  priceId      String?
  amountMinor  Int          @default(0)
  currency     Currency
  invoiceId    String?

  project Project  @relation(fields: [projectId], references: [id])
  price   Price?   @relation(fields: [priceId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([resourceType, resourceId, hourStart])
  @@index([projectId, hourStart])
  @@index([invoiceId])
}

/// USD → quote exchange rates, newest wins. Every price is in USD; riyals are derived.
model FxRate {
  id     String   @id @default(cuid())
  base   Currency @default(USD)
  quote  Currency
  rate   Decimal  @db.Decimal(18, 6)
  source String // provider URL, "admin", "seed"
  at     DateTime @default(now())

  @@index([base, quote, at])
}

/// Price book in USD. hourly = monthly / BILLING_HOURS_PER_MONTH, capped at monthly.
/// Other currencies are converted by FxService at the moment of pricing or rating.
model Price {
  id           String       @id @default(cuid())
  resourceType ResourceType
  sku          String // size id, "snapshot_gb", "public_ip", "bandwidth_gb"
  sizeId       String?
  currency     Currency
  monthlyMinor Int
  unit         String       @default("hour")
  validFrom    DateTime     @default(now())
  validTo      DateTime?

  size    Size?         @relation(fields: [sizeId], references: [id])
  records UsageRecord[]

  @@index([resourceType, sku, currency, validFrom])
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
  /// Fully reversed by credit notes.
  credited
}

model Invoice {
  id          String        @id @default(cuid())
  teamId      String
  number      String        @unique // "PRGD-2026-000123", from the invoice_number_seq sequence
  currency    Currency
  periodStart DateTime
  periodEnd   DateTime
  subtotalMinor Int
  taxMinor    Int           @default(0) // VAT 15% for SA
  creditMinor Int           @default(0)
  totalMinor  Int
  /// Credit notes applied against what is still due (open invoices only). Due = totalMinor - creditedMinor.
  creditedMinor Int         @default(0)
  status      InvoiceStatus @default(draft)
  eInvoiceId  String? // ZATCA e-invoicing provider reference
  eInvoiceType String? // "zatca" for Saudi teams (Fatoora), null otherwise
  dueAt       DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  /// Last overdue reminder sent: 0 none, then 3, 7 or 14 days past dueAt. At 14 the team is suspended.
  reminderStage  Int        @default(0)
  lastReminderAt DateTime?
  createdAt   DateTime      @default(now())

  team    Team          @relation(fields: [teamId], references: [id])
  records UsageRecord[]
  payments Payment[]
  creditNotes CreditNote[]

  @@unique([teamId, periodStart, periodEnd])
  @@index([status, dueAt])
}

enum CreditKind {
  promo
  prepaid
  refund
  goodwill
}

model Credit {
  id          String     @id @default(cuid())
  teamId      String
  kind        CreditKind
  currency    Currency
  amountMinor Int
  remainingMinor Int
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  team Team @relation(fields: [teamId], references: [id])
}

enum PaymentProvider {
  moyasar
  bank_transfer
  manual
  /// The built in test page (development and demos). Never set in production.
  fake
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model Payment {
  id          String          @id @default(cuid())
  teamId      String
  invoiceId   String?
  provider    PaymentProvider
  providerRef String?
  currency    Currency
  amountMinor Int
  status      PaymentStatus   @default(pending)
  failureReason String?
  /// Refunded so far; the status becomes refunded once it equals amountMinor.
  refundedMinor Int           @default(0)
  /// The provider's reference for the refund (for Moyasar, the refunded payment id).
  refundRef   String?
  refundedAt  DateTime?
  /// Return URLs and the adapter that created the checkout (fake in development).
  metadata    Json            @default("{}")
  paidAt      DateTime?
  createdAt   DateTime        @default(now())

  team    Team     @relation(fields: [teamId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, status])
  @@index([provider, providerRef])
  @@index([teamId, createdAt])
}

// ───────────────────────── Trust & safety ─────────────────────────

/// Reverses all or part of an issued invoice. Numbered from credit_note_number_seq (CN-2026-000045).
model CreditNote {
  id          String   @id @default(cuid())
  number      String   @unique
  teamId      String
  invoiceId   String
  currency    Currency
  amountMinor Int
  /// Part applied against what was still due on an open invoice; the rest became refund credit.
  appliedToDueMinor Int @default(0)
  creditId    String?
  reason      String
  createdBy   String? // staff userId
  createdAt   DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([teamId, createdAt])
  @@index([invoiceId])
}

enum AbuseKind {
  mining
  spam
  scanning
  ddos_source
  phishing
  payment_fraud
  report
}

model AbuseFlag {
  id        String    @id @default(cuid())
  teamId    String
  serverId  String?
  kind      AbuseKind
  score     Int       @default(0)
  evidence  Json      @default("{}")
  source    String // "ai-ops" | "abuse-report" | "payment"
  resolvedAt DateTime?
  resolution String? // "false_positive" | "warned" | "suspended"
  createdAt DateTime  @default(now())
  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, resolvedAt])
}

// ───────────────────────── Events, audit, webhooks ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  teamId    String?
  userId    String?
  tokenId   String?
  action    String // "servers.create"
  resource  String? // "server:cxyz"
  ip        String?
  userAgent String?
  request   Json?
  status    Int
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, at])
}

model Webhook {
  id        String   @id @default(cuid())
  teamId    String
  url       String
  secret    String
  events    String[] // ["server.active","invoice.issued","spend.limit_reached"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String    @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  attempts   Int       @default(0)
  lastStatus Int?
  deliveredAt DateTime?
  nextAttemptAt DateTime?
  createdAt  DateTime  @default(now())
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, nextAttemptAt])
}

// ───────────────────────── Git Deploy ─────────────────────────

enum DeployStatus {
  creating
  deploying
  live
  failed
}

/// A Git repository deployed onto a server: clone → build (Dockerfile / compose) → run,
/// and redeploy on every push via a GitHub webhook. The "git push → live" loop.
model Deployment {
  id            String       @id @default(cuid())
  projectId     String
  serverId      String       @unique
  name          String
  repoUrl       String // https://github.com/org/repo
  branch        String       @default("main")
  /// Container port the app listens on; exposed on :80 of the server.
  port          Int          @default(3000)
  /// Secret GitHub signs push webhooks with (shown once).
  webhookSecret String
  /// Secret the control plane uses to call the redeploy hook on the VM.
  vmSecret      String
  envVars       Json         @default("{}")
  status        DeployStatus @default(creating)
  lastCommit    String?
  lastDeployAt  DateTime?
  /// GitHub App based deployments: which installation clones the repo, and "owner/name" for push matching.
  installationId String?
  repoFullName   String?
  /// Tail of the last build log pulled from the server (capped), for the console and CLI.
  buildLog       String?
  logUpdatedAt   DateTime?
  createdAt     DateTime     @default(now())

  server       Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id])
  installation GithubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([repoFullName, branch])
}

/// A GitHub App installation on a customer account or organization, linked to one team.
model GithubInstallation {
  id             String    @id @default(cuid())
  teamId         String
  installationId Int       @unique
  accountLogin   String
  accountType    String // User | Organization
  suspendedAt    DateTime?
  createdAt      DateTime  @default(now())

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  platformApps PlatformApp[]

  @@index([teamId])
}

/// "Notify me" clicks on roadmap products in the console — feeds prioritisation.
model ProductInterest {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  product   String // slug from the console product catalog
  note      String?
  createdAt DateTime @default(now())

  @@unique([teamId, product])
  @@index([product])
}

/// Idempotency-Key storage for POST endpoints (24h TTL enforced by cleanup job).
model IdempotencyKey {
  key        String   @id
  teamId     String
  requestHash String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── Monitoring ─────────────────────────

/// One metrics sample per server per minute (rates already derived from the agent's counters).
model MetricSample {
  serverId        String
  at              DateTime
  cpuPercent      Float    @default(0)
  memoryUsedMb    Int      @default(0)
  memoryTotalMb   Int      @default(0)
  netInBps        Float    @default(0)
  netOutBps       Float    @default(0)
  diskReadBps     Float    @default(0)
  diskWriteBps    Float    @default(0)
  diskUsedPercent Float?

  @@id([serverId, at])
  @@index([at])
}

/// Hourly rollup of MetricSample, kept for a year.
model MetricHourly {
  serverId      String
  at            DateTime
  cpuPercent    Float
  cpuMax        Float
  memoryUsedMb  Int
  memoryTotalMb Int
  netInBps      Float
  netOutBps     Float
  diskReadBps   Float
  diskWriteBps  Float
  samples       Int

  @@id([serverId, at])
}

/// Last cumulative counters per server, to turn the agent's totals into per second rates.
model MetricCursor {
  serverId       String   @id
  at             DateTime
  netInBytes     BigInt
  netOutBytes    BigInt
  diskReadBytes  BigInt
  diskWriteBytes BigInt
}

enum AlertMetric {
  cpu
  memory
  disk
  net_in
  net_out
  /// Event based: a managed database node unreachable for five minutes. Threshold and window are ignored.
  db_node_unreachable
  /// Event based: an App Platform deploy failed. Threshold and window are ignored.
  app_deploy_failed
}

enum AlertComparator {
  above
  below
}

/// A resource alert rule: metric over a threshold for a window, on chosen servers or tags.
model AlertPolicy {
  id            String          @id @default(cuid())
  teamId        String
  name          String
  metric        AlertMetric
  comparator    AlertComparator @default(above)
  /// Percent for cpu, memory and disk; megabits per second for network.
  threshold     Float
  windowMinutes Int             @default(5)
  /// Empty serverIds and tags means every server in the team.
  serverIds     String[]        @default([])
  tags          String[]        @default([])
  /// Extra recipients; team owners always get the email.
  emails        String[]        @default([])
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incidents AlertIncident[]

  @@index([teamId])
}

model AlertIncident {
  id         String    @id @default(cuid())
  policyId   String
  teamId     String
  serverId   String
  value      Float
  peakValue  Float
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  policy AlertPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([teamId, resolvedAt, startedAt])
  @@index([policyId, serverId, resolvedAt])
}

// ───────────────────────── Block volumes ─────────────────────────

enum VolumeStatus {
  creating
  available
  attaching
  attached
  detaching
  resizing
  deleting
  failed
  deleted
}

/// A Ceph RBD image the customer attaches to one server at a time. Billed per GB per month
/// from creation, attached or not.
model Volume {
  id            String       @id @default(cuid())
  projectId     String
  regionId      String
  name          String
  sizeGb        Int
  status        VolumeStatus @default(creating)
  statusMessage String?
  serverId      String?
  /// Guest facing path, /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_<serial>
  device        String?
  /// Driver handle: storage and image name on Proxmox, opaque outside the driver.
  driverRef     String?
  meteredSince  DateTime?
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id])
  region  Region  @relation(fields: [regionId], references: [id])
  server  Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([serverId])
}

// ───────────────────────── Load balancers ─────────────────────────

enum LoadBalancerStatus {
  creating
  active
  updating
  failed
  deleting
  deleted
}

enum LbAlgorithm {
  round_robin
  least_conn
}

enum CertificateType {
  custom
  letsencrypt
}

/// TLS certificate for HTTPS forwarding rules: uploaded PEM, or domains that the
/// load balancer nodes get issued by Let's Encrypt.
model Certificate {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CertificateType
  domains   String[]        @default([])
  certPem   String?
  keyPem    String?
  notAfter  DateTime?
  createdAt DateTime        @default(now())
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

/// A managed HAProxy in front of servers. We run one to three node VMs (Server rows with
/// managedBy = "lb:<id>", hidden from the customer's server list) that share a VIP through
/// keepalived; the control plane pushes the rendered config to each node.
model LoadBalancer {
  id                  String             @id @default(cuid())
  projectId           String
  regionId            String
  name                String
  status              LoadBalancerStatus @default(creating)
  statusMessage       String?
  algorithm           LbAlgorithm        @default(round_robin)
  nodes               Int                @default(1)
  /// [{ entryProtocol: http|https|tcp, entryPort, targetProtocol: http|tcp, targetPort, certificateId? }]
  forwardingRules     Json
  /// { protocol: http|tcp, port, path?, intervalSeconds, timeoutSeconds, healthyThreshold, unhealthyThreshold }
  healthCheck         Json
  /// { type: cookie, cookieName?, ttlSeconds? } or null for none
  stickySessions      Json?
  redirectHttpToHttps Boolean            @default(false)
  proxyProtocol       Boolean            @default(false)
  /// Servers carrying this tag are targets automatically.
  tag                 String?
  publicIpId          String?            @unique
  firewallId          String?
  vmSecret            String
  /// Bumped on every change; nodes report the version they run.
  configVersion       Int                @default(1)
  meteredSince        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  project     Project              @relation(fields: [projectId], references: [id])
  region      Region               @relation(fields: [regionId], references: [id])
  publicIp    PublicIp?            @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  nodeServers LoadBalancerNode[]
  targets     LoadBalancerTarget[]

  @@index([projectId])
}

model LoadBalancerNode {
  id             String    @id @default(cuid())
  loadBalancerId String
  serverId       String    @unique
  index          Int
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?

  loadBalancer LoadBalancer @relation(fields: [loadBalancerId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model LoadBalancerTarget {
  id             String    @id @default(cuid())
  loadBalancerId String
  serverId       String
  healthy        Boolean?
  lastCheckedAt  DateTime?

  loadBalancer LoadBalancer @relation(fields: [loadBalancerId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([loadBalancerId, serverId])
}

// ───────────────────────── DNS ─────────────────────────

enum DnsZoneStatus {
  pending
  active
  error
  deleting
  deleted
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
}

/// A hosted zone. The database is the source of truth; every change bumps `serial` and the
/// zone is pushed whole to the nameservers (PowerDNS), which report back through syncedSerial.
model DnsZone {
  id            String        @id @default(cuid())
  projectId     String
  name          String
  status        DnsZoneStatus @default(pending)
  statusMessage String?
  serial        Int           @default(1)
  syncedSerial  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  project Project     @relation(fields: [projectId], references: [id])
  records DnsRecord[]

  @@index([projectId])
}

model DnsRecord {
  id        String        @id @default(cuid())
  zoneId    String
  /// Relative name: "@" for the apex, "www", "_sip._tcp"
  name      String
  type      DnsRecordType
  content   String
  ttl       Int           @default(3600)
  /// MX preference or SRV priority
  priority  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  zone DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

// ───────────────────────── Object storage ─────────────────────────

enum BucketStatus {
  creating
  active
  deleting
  deleted
  failed
}

/// An S3 bucket on the region's Ceph RADOS Gateway, owned by the project's RGW user.
/// Names are global and DNS safe so virtual host addressing works.
model Bucket {
  id             String       @id @default(cuid())
  projectId      String
  regionId       String
  name           String
  status         BucketStatus @default(creating)
  statusMessage  String?
  /// Anyone can read objects (bucket policy s3:GetObject for *).
  public         Boolean      @default(false)
  sizeBytes      BigInt       @default(0)
  objectCount    Int          @default(0)
  usageUpdatedAt DateTime?
  meteredSince   DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])
  region  Region  @relation(fields: [regionId], references: [id])

  @@index([projectId])
}

/// An S3 access key pair on the project's RGW user. The secret is shown once at creation.
model StorageKey {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  accessKey  String    @unique
  secretKey  String
  createdBy  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

// ───────────────────────── Managed databases ─────────────────────────

enum DbEngine {
  postgres
  valkey
  mysql
}

enum DbClusterStatus {
  creating
  active
  updating
  failed
  restoring
  deleting
  deleted
}

enum DbBackupStatus {
  running
  completed
  failed
}

/// A managed database cluster: one or three platform owned node VMs (Server rows with
/// managedBy = "db:<id>"), a VIP that follows the primary, users and databases we apply,
/// nightly backups to a platform bucket. The control plane is the only writer of node config.
model DbCluster {
  id              String          @id @default(cuid())
  projectId       String
  regionId        String
  name            String
  engine          DbEngine
  version         String
  status          DbClusterStatus @default(creating)
  statusMessage   String?
  nodes           Int             @default(1)
  sizeId          String
  port            Int
  adminUser       String
  adminPassword   String
  /// CIDRs allowed to reach the database port; empty means anywhere (password and TLS still apply).
  trustedSources  String[]        @default([])
  publicIpId      String?         @unique
  firewallId      String?
  vmSecret        String
  configVersion   Int             @default(1)
  backupBucket    String?
  backupAccessKey String?
  backupSecretKey String?
  backupHourUtc   Int             @default(2)
  meteredSince    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  project     Project      @relation(fields: [projectId], references: [id])
  region      Region       @relation(fields: [regionId], references: [id])
  size        Size         @relation(fields: [sizeId], references: [id])
  publicIp    PublicIp?    @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  nodeServers DbNode[]
  users       DbUser[]
  databases   DbDatabase[]
  backups     DbBackup[]

  @@index([projectId])
}

model DbNode {
  id             String    @id @default(cuid())
  clusterId      String
  serverId       String    @unique
  index          Int
  /// primary | replica | unknown, as last reported by the node
  role           String    @default("unknown")
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?
  lagBytes       BigInt?

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  server  Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model DbUser {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  password  String
  createdAt DateTime @default(now())

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, name])
}

model DbDatabase {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  createdAt DateTime @default(now())

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, name])
}

model DbBackup {
  id          String         @id @default(cuid())
  clusterId   String
  /// scheduled | manual
  kind        String         @default("scheduled")
  status      DbBackupStatus @default(running)
  sizeBytes   BigInt?
  label       String?
  /// Engine side name of the backup: pgBackRest set label, or the object key of the RDB or XtraBackup stream.
  ref         String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  error       String?

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId])
}

/// ---------------------------------------------------------------------------
/// Support plans and tickets
/// ---------------------------------------------------------------------------
enum SupportPlan {
  free
  developer
  standard
  premium
}

enum TicketStatus {
  open // waiting on us
  answered // waiting on the customer
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

model Ticket {
  id        String         @id @default(cuid())
  teamId    String
  number    Int            @default(autoincrement())
  subject   String
  status    TicketStatus   @default(open)
  priority  TicketPriority @default(normal)
  plan      SupportPlan // plan at the time it was opened; sets the response target
  resource  String? // "server:<id>", "database:<id>" ...
  createdById String?
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  lastCustomerAt     DateTime @default(now())
  lastSupportAt      DateTime?
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TicketMessage[]

  @@index([teamId, status])
  @@index([status, priority, createdAt])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromSupport Boolean @default(false)
  authorId   String? // user id; null for system notes
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// ---------------------------------------------------------------------------
/// Managed Kubernetes
/// ---------------------------------------------------------------------------
enum KubeClusterStatus {
  creating
  active
  updating
  failed
  deleting
  deleted
}

model KubeCluster {
  id            String            @id @default(cuid())
  projectId     String
  regionId      String
  name          String
  version       String
  status        KubeClusterStatus @default(creating)
  statusMessage String?
  /// Three control plane nodes instead of one.
  ha            Boolean           @default(false)
  controlSizeId String
  publicIpId    String?           @unique
  firewallId    String?
  vmSecret      String
  joinToken     String
  certKey       String
  caHash        String?
  kubeconfig    String?
  podCidr       String            @default("10.244.0.0/16")
  serviceCidr   String            @default("10.96.0.0/12")
  configVersion Int               @default(1)
  /// Cloud controller state: load balancers and volumes created for Services and PVCs.
  cloudState    Json              @default("{}")
  /// Platform owned bucket for daily etcd snapshots; null keeps snapshots on the control plane nodes.
  backupBucket    String?
  backupAccessKey String?
  backupSecretKey String?
  meteredSince  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  project     Project        @relation(fields: [projectId], references: [id])
  region      Region         @relation(fields: [regionId], references: [id])
  controlSize Size           @relation("KubeControlSize", fields: [controlSizeId], references: [id])
  publicIp    PublicIp?      @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  pools       KubeNodePool[]
  nodes       KubeNode[]

  @@index([projectId])
}

model KubeNodePool {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  sizeId    String
  count     Int
  labels    Json     @default("{}")
  taints    Json     @default("[]")
  createdAt DateTime @default(now())

  cluster KubeCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  size    Size        @relation("KubePoolSize", fields: [sizeId], references: [id])
  nodes   KubeNode[]

  @@unique([clusterId, name])
}

model KubeNode {
  id             String    @id @default(cuid())
  clusterId      String
  poolId         String?
  serverId       String    @unique
  index          Int
  /// control | worker
  role           String
  ready          Boolean   @default(false)
  kubeVersion    String?
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?

  cluster KubeCluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  pool    KubeNodePool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  server  Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([clusterId])
}

/// ---------------------------------------------------------------------------
/// App Platform: containers on shared, platform owned hosts
/// ---------------------------------------------------------------------------
enum AppHostStatus {
  provisioning
  active
  draining
  failed
}

enum PlatformAppStatus {
  creating
  building
  live
  failed
  stopped
  deleting
  deleted
}

enum AppDeployStatus {
  queued
  building
  live
  failed
}

/// A platform owned server that runs customer app containers behind Caddy.
model AppHost {
  id            String        @id @default(cuid())
  regionId      String
  serverId      String        @unique
  status        AppHostStatus @default(provisioning)
  /// Memory available to apps after the host's own reserve.
  capacityMb    Int
  vmSecret      String
  configVersion Int           @default(1)
  /// Last time the agent reported Docker and Caddy running.
  readyAt       DateTime?
  createdAt     DateTime      @default(now())

  region Region        @relation(fields: [regionId], references: [id])
  server Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  apps   PlatformApp[]
}

model PlatformApp {
  id             String            @id @default(cuid())
  projectId      String
  regionId       String
  hostId         String?
  /// Hostname label under APPS_DOMAIN; unique across the platform.
  slug           String            @unique
  name           String
  status         PlatformAppStatus @default(creating)
  statusMessage  String?
  repoUrl        String
  branch         String            @default("main")
  repoFullName   String?
  installationId String?
  /// Customer token for private repositories without the GitHub App.
  gitToken       String?
  port           Int               @default(3000)
  envVars        Json              @default("{}")
  /// app-xs | app-s | app-m | app-l
  size           String            @default("app-xs")
  instances      Int               @default(1)
  healthPath     String?
  customDomains  String[]          @default([])
  /// Ownership checks per custom domain: { "<domain>": { "token": "...", "verifiedAt": "<ISO time>" | null } }.
  /// Only verified domains are served.
  domainChecks   Json              @default("{}")
  lastCommit     String?
  lastDeployAt   DateTime?
  buildLog       String?
  meteredSince   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  project      Project             @relation(fields: [projectId], references: [id])
  region       Region              @relation(fields: [regionId], references: [id])
  host         AppHost?            @relation(fields: [hostId], references: [id], onDelete: SetNull)
  installation GithubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  deploys      AppDeploy[]

  @@index([projectId])
  @@index([repoFullName, branch])
}

model AppDeploy {
  id         String          @id @default(cuid())
  appId      String
  status     AppDeployStatus @default(queued)
  /// create | push | manual | config
  trigger    String
  commit     String?
  log        String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  app PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, startedAt])
}

/// A console sign in. The session JWT carries this id; revoking the row ends the session at once.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}
