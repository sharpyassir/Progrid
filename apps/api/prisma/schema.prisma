  @@index([projectId])
  @@index([serverId])

  @@map("prgd_volumes")
}

// ───────────────────────── Load balancers ─────────────────────────

enum LoadBalancerStatus {
  creating
  active
  updating
  failed
  deleting
  deleted

  @@map("prgd_load_balancer_status")
}

enum LbAlgorithm {
  round_robin
  least_conn

  @@map("prgd_lb_algorithm")
}

enum CertificateType {
  custom
  letsencrypt

  @@map("prgd_certificate_type")
}

/// TLS certificate for HTTPS forwarding rules: uploaded PEM, or domains that the
/// load balancer nodes get issued by Let's Encrypt.
model Certificate {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CertificateType
  domains   String[]        @default([])
  certPem   String?
  keyPem    String?
  notAfter  DateTime?
  createdAt DateTime        @default(now())
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])

  @@map("prgd_certificates")
}

/// A managed HAProxy in front of servers. We run one to three node VMs (Server rows with
/// managedBy = "lb:<id>", hidden from the customer's server list) that share a VIP through
/// keepalived; the control plane pushes the rendered config to each node.
model LoadBalancer {
  id                  String             @id @default(cuid())
  projectId           String
  regionId            String
  name                String
  status              LoadBalancerStatus @default(creating)
  statusMessage       String?
  algorithm           LbAlgorithm        @default(round_robin)
  nodes               Int                @default(1)
  /// [{ entryProtocol: http|https|tcp, entryPort, targetProtocol: http|tcp, targetPort, certificateId? }]
  forwardingRules     Json
  /// { protocol: http|tcp, port, path?, intervalSeconds, timeoutSeconds, healthyThreshold, unhealthyThreshold }
  healthCheck         Json
  /// { type: cookie, cookieName?, ttlSeconds? } or null for none
  stickySessions      Json?
  redirectHttpToHttps Boolean            @default(false)
  proxyProtocol       Boolean            @default(false)
  /// Servers carrying this tag are targets automatically.
  tag                 String?
  publicIpId          String?            @unique
  firewallId          String?
  vmSecret            String
  /// Bumped on every change; nodes report the version they run.
  configVersion       Int                @default(1)
  meteredSince        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  project     Project              @relation(fields: [projectId], references: [id])
  region      Region               @relation(fields: [regionId], references: [id])
  publicIp    PublicIp?            @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  nodeServers LoadBalancerNode[]
  targets     LoadBalancerTarget[]

  @@index([projectId])

  @@map("prgd_load_balancers")
}

model LoadBalancerNode {
  id             String    @id @default(cuid())
  loadBalancerId String
  serverId       String    @unique
  index          Int
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?

  loadBalancer LoadBalancer @relation(fields: [loadBalancerId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("prgd_load_balancer_nodes")
}

model LoadBalancerTarget {
  id             String    @id @default(cuid())
  loadBalancerId String
  serverId       String
  healthy        Boolean?
  lastCheckedAt  DateTime?

  loadBalancer LoadBalancer @relation(fields: [loadBalancerId], references: [id], onDelete: Cascade)
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([loadBalancerId, serverId])

  @@map("prgd_load_balancer_targets")
}

// ───────────────────────── DNS ─────────────────────────

enum DnsZoneStatus {
  pending
  active
  error
  deleting
  deleted

  @@map("prgd_dns_zone_status")
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA

  @@map("prgd_dns_record_type")
}

/// A hosted zone. The database is the source of truth; every change bumps `serial` and the
/// zone is pushed whole to the nameservers (PowerDNS), which report back through syncedSerial.
model DnsZone {
  id            String        @id @default(cuid())
  projectId     String
  name          String
  status        DnsZoneStatus @default(pending)
  statusMessage String?
  serial        Int           @default(1)
  syncedSerial  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  project Project     @relation(fields: [projectId], references: [id])
  records DnsRecord[]

  @@index([projectId])

  @@map("prgd_dns_zones")
}

model DnsRecord {
  id        String        @id @default(cuid())
  zoneId    String
  /// Relative name: "@" for the apex, "www", "_sip._tcp"
  name      String
  type      DnsRecordType
  content   String
  ttl       Int           @default(3600)
  /// MX preference or SRV priority
  priority  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  zone DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])

  @@map("prgd_dns_records")
}

// ───────────────────────── Object storage ─────────────────────────

enum BucketStatus {
  creating
  active
  deleting
  deleted
  failed

  @@map("prgd_bucket_status")
}

/// An S3 bucket on the region's Ceph RADOS Gateway, owned by the project's RGW user.
/// Names are global and DNS safe so virtual host addressing works.
model Bucket {
  id             String       @id @default(cuid())
  projectId      String
  regionId       String
  name           String
  status         BucketStatus @default(creating)
  statusMessage  String?
  /// Anyone can read objects (bucket policy s3:GetObject for *).
  public         Boolean      @default(false)
  sizeBytes      BigInt       @default(0)
  objectCount    Int          @default(0)
  usageUpdatedAt DateTime?
  meteredSince   DateTime?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])
  region  Region  @relation(fields: [regionId], references: [id])

  @@index([projectId])

  @@map("prgd_buckets")
}

/// An S3 access key pair on the project's RGW user. The secret is shown once at creation.
model StorageKey {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  accessKey  String    @unique
  secretKey  String
  createdBy  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])

  @@map("prgd_storage_keys")
}

// ───────────────────────── Managed databases ─────────────────────────

enum DbEngine {
  postgres
  valkey
  mysql

  @@map("prgd_db_engine")
}

enum DbClusterStatus {
  creating
  active
  updating
  failed
  restoring
  deleting
  deleted

  @@map("prgd_db_cluster_status")
}

enum DbBackupStatus {
  running
  completed
  failed

  @@map("prgd_db_backup_status")
}

/// A managed database cluster: one or three platform owned node VMs (Server rows with
/// managedBy = "db:<id>"), a VIP that follows the primary, users and databases we apply,
/// nightly backups to a platform bucket. The control plane is the only writer of node config.
model DbCluster {
  id              String          @id @default(cuid())
  projectId       String
  regionId        String
  name            String
  engine          DbEngine
  version         String
  status          DbClusterStatus @default(creating)
  statusMessage   String?
  nodes           Int             @default(1)
  sizeId          String
  port            Int
  adminUser       String
  adminPassword   String
  /// CIDRs allowed to reach the database port; empty means anywhere (password and TLS still apply).
  trustedSources  String[]        @default([])
  publicIpId      String?         @unique
  firewallId      String?
  vmSecret        String
  configVersion   Int             @default(1)
  backupBucket    String?
  backupAccessKey String?
  backupSecretKey String?
  backupHourUtc   Int             @default(2)
  meteredSince    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  project     Project      @relation(fields: [projectId], references: [id])
  region      Region       @relation(fields: [regionId], references: [id])
  size        Size         @relation(fields: [sizeId], references: [id])
  publicIp    PublicIp?    @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  nodeServers DbNode[]
  users       DbUser[]
  databases   DbDatabase[]
  backups     DbBackup[]

  @@index([projectId])

  @@map("prgd_db_clusters")
}

model DbNode {
  id             String    @id @default(cuid())
  clusterId      String
  serverId       String    @unique
  index          Int
  /// primary | replica | unknown, as last reported by the node
  role           String    @default("unknown")
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?
  lagBytes       BigInt?

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  server  Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("prgd_db_nodes")
}

model DbUser {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  password  String
  createdAt DateTime @default(now())

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, name])

  @@map("prgd_db_users")
}

model DbDatabase {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  createdAt DateTime @default(now())

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, name])

  @@map("prgd_db_databases")
}

model DbBackup {
  id          String         @id @default(cuid())
  clusterId   String
  /// scheduled | manual
  kind        String         @default("scheduled")
  status      DbBackupStatus @default(running)
  sizeBytes   BigInt?
  label       String?
  /// Engine side name of the backup: pgBackRest set label, or the object key of the RDB or XtraBackup stream.
  ref         String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  error       String?

  cluster DbCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId])

  @@map("prgd_db_backups")
}

/// ---------------------------------------------------------------------------
/// Support plans and tickets
/// ---------------------------------------------------------------------------
enum SupportPlan {
  free
  developer
  standard
  premium

  @@map("prgd_support_plan")
}

enum TicketStatus {
  open // waiting on us
  answered // waiting on the customer
  closed
  /// A managed P1 that is resolved but still needs its postmortem. Customers see it as closed.
  resolved_pending_pm

  @@map("prgd_ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("prgd_ticket_priority")
}

model Ticket {
  id        String         @id @default(cuid())
  teamId    String
  number    Int            @default(autoincrement())
  subject   String
  status    TicketStatus   @default(open)
  priority  TicketPriority @default(normal)
  plan      SupportPlan // plan at the time it was opened; sets the response target
  resource  String? // "server:<id>", "database:<id>" ...
  createdById String?
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  lastCustomerAt     DateTime @default(now())
  lastSupportAt      DateTime?
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TicketMessage[]

  // Managed cloud: set on tickets tied to a managed contract. `priority` mirrors
  // managedPriority (P1 urgent, P2 high, P3 normal, P4 low) so the support queue sorts them too.
  contractId      String?
  assetId         String?
  managedPriority ManagedPriority?
  /// Staff user working the ticket.
  assigneeId      String?
  /// Due times from the contract plan's per priority targets and calendar (see modules/managed/sla).
  responseDueAt   DateTime?
  resolveDueAt    DateTime?
  /// First SLA warning (75 percent of a target) and first breach, whichever timer fired first.
  warnedAt        DateTime?
  breachedAt      DateTime?
  responseBreached Boolean @default(false)
  resolveBreached  Boolean @default(false)
  /// Set when an alert or a failed maintenance run opened the ticket.
  source          String?

  contract ManagedContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  asset    ManagedAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignee User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  alerts   Alert[]
  pages    Page[]
  workLogs WorkLog[]
  maintenanceRuns MaintenanceRun[]
  workTimers WorkTimer[]
  accessGrants AccessGrant[]
  postmortem Postmortem?

  @@index([contractId, status])
  @@index([assigneeId, status])
  @@index([teamId, status])
  @@index([status, priority, createdAt])

  @@map("prgd_tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromSupport Boolean @default(false)
  authorId   String? // user id; null for system notes
  authorName String
  body       String
  /// Staff only note. Customer endpoints never return internal messages.
  internal   Boolean  @default(false)
  /// Internal note recording the root cause, required before an engineer closes a managed ticket from the ops console.
  rootCause  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])

  @@map("prgd_ticket_messages")
}

/// ---------------------------------------------------------------------------
/// Managed Kubernetes
/// ---------------------------------------------------------------------------
enum KubeClusterStatus {
  creating
  active
  updating
  failed
  deleting
  deleted

  @@map("prgd_kube_cluster_status")
}

model KubeCluster {
  id            String            @id @default(cuid())
  projectId     String
  regionId      String
  name          String
  version       String
  status        KubeClusterStatus @default(creating)
  statusMessage String?
  /// Three control plane nodes instead of one.
  ha            Boolean           @default(false)
  controlSizeId String
  publicIpId    String?           @unique
  firewallId    String?
  vmSecret      String
  joinToken     String
  certKey       String
  caHash        String?
  kubeconfig    String?
  podCidr       String            @default("10.244.0.0/16")
  serviceCidr   String            @default("10.96.0.0/12")
  configVersion Int               @default(1)
  /// Cloud controller state: load balancers and volumes created for Services and PVCs.
  cloudState    Json              @default("{}")
  /// Platform owned bucket for daily etcd snapshots; null keeps snapshots on the control plane nodes.
  backupBucket    String?
  backupAccessKey String?
  backupSecretKey String?
  meteredSince  DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  project     Project        @relation(fields: [projectId], references: [id])
  region      Region         @relation(fields: [regionId], references: [id])
  controlSize Size           @relation("KubeControlSize", fields: [controlSizeId], references: [id])
  publicIp    PublicIp?      @relation(fields: [publicIpId], references: [id], onDelete: SetNull)
  pools       KubeNodePool[]
  nodes       KubeNode[]

  @@index([projectId])

  @@map("prgd_kube_clusters")
}

model KubeNodePool {
  id        String   @id @default(cuid())
  clusterId String
  name      String
  sizeId    String
  count     Int
  labels    Json     @default("{}")
  taints    Json     @default("[]")
  createdAt DateTime @default(now())

  cluster KubeCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  size    Size        @relation("KubePoolSize", fields: [sizeId], references: [id])
  nodes   KubeNode[]

  @@unique([clusterId, name])

  @@map("prgd_kube_node_pools")
}

model KubeNode {
  id             String    @id @default(cuid())
  clusterId      String
  poolId         String?
  serverId       String    @unique
  index          Int
  /// control | worker
  role           String
  ready          Boolean   @default(false)
  kubeVersion    String?
  appliedVersion Int       @default(0)
  lastSeenAt     DateTime?

  cluster KubeCluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  pool    KubeNodePool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  server  Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([clusterId])

  @@map("prgd_kube_nodes")
}

/// ---------------------------------------------------------------------------
/// App Platform: containers on shared, platform owned hosts
/// ---------------------------------------------------------------------------
enum AppHostStatus {
  provisioning
  active
  draining
  failed

  @@map("prgd_app_host_status")
}

enum PlatformAppStatus {
  creating
  building
  live
  failed
  stopped
  deleting
  deleted

  @@map("prgd_platform_app_status")
}

enum AppDeployStatus {
  queued
  building
  live
  failed

  @@map("prgd_app_deploy_status")
}

/// A platform owned server that runs customer app containers behind Caddy.
model AppHost {
  id            String        @id @default(cuid())
  regionId      String
  serverId      String        @unique
  status        AppHostStatus @default(provisioning)
  /// Memory available to apps after the host's own reserve.
  capacityMb    Int
  vmSecret      String
  configVersion Int           @default(1)
  /// Last time the agent reported Docker and Caddy running.
  readyAt       DateTime?
  createdAt     DateTime      @default(now())

  region Region        @relation(fields: [regionId], references: [id])
  server Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  apps   PlatformApp[]

  @@map("prgd_app_hosts")
}

model PlatformApp {
  id             String            @id @default(cuid())
  projectId      String
  regionId       String
  hostId         String?
  /// Hostname label under APPS_DOMAIN; unique across the platform.
  slug           String            @unique
  name           String
  status         PlatformAppStatus @default(creating)
  statusMessage  String?
  repoUrl        String
  branch         String            @default("main")
  repoFullName   String?
  installationId String?
  /// Customer token for private repositories without the GitHub App.
  gitToken       String?
  port           Int               @default(3000)
  envVars        Json              @default("{}")
  /// app-xs | app-s | app-m | app-l
  size           String            @default("app-xs")
  instances      Int               @default(1)
  healthPath     String?
  customDomains  String[]          @default([])
  /// Ownership checks per custom domain: { "<domain>": { "token": "...", "verifiedAt": "<ISO time>" | null } }.
  /// Only verified domains are served.
  domainChecks   Json              @default("{}")
  lastCommit     String?
  lastDeployAt   DateTime?
  buildLog       String?
  meteredSince   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  project      Project             @relation(fields: [projectId], references: [id])
  region       Region              @relation(fields: [regionId], references: [id])
  host         AppHost?            @relation(fields: [hostId], references: [id], onDelete: SetNull)
  installation GithubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  deploys      AppDeploy[]

  @@index([projectId])
  @@index([repoFullName, branch])

  @@map("prgd_platform_apps")
}

model AppDeploy {
  id         String          @id @default(cuid())
  appId      String
  status     AppDeployStatus @default(queued)
  /// create | push | manual | config
  trigger    String
  commit     String?
  log        String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  app PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, startedAt])

  @@map("prgd_app_deploys")
}

/// A console or ops console sign in. The session JWT carries this id; revoking the row ends the session at once.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The team the console session works in; null for ops sessions.
  teamId     String?
  /// console (apps/console, /v1 and /admin) or ops (apps/ops, /ops/v1 only). A token never works for the other audience.
  audience   String    @default("console")
  /// Second factor used to open an ops session: totp or webauthn.
  secondFactor String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([userId, audience, createdAt])

  @@map("prgd_sessions")
}

enum OAuthProvider {
  google
  microsoft

  @@map("prgd_oauth_provider")
}

/// A Google or Microsoft account linked to a user for social sign in (docs/social-sign-in.md).
model OAuthIdentity {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      OAuthProvider
  /// The id token `sub`: stable per provider account (per app for Microsoft).
  subject       String
  email         String
  emailVerified Boolean   @default(false)
  /// Microsoft directory (tid) the account belongs to; null for Google.
  tenantId      String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@unique([provider, subject])
  @@index([userId])
  @@map("prgd_oauth_identities")
}

/// ---------------------------------------------------------------------------
/// Managed cloud: we operate customer servers under an SLA.
/// Money is integer minor units plus a currency code. See docs/managed-cloud-operations.md.
/// ---------------------------------------------------------------------------
enum ManagedCoverage {
  BUSINESS_HOURS
  TWENTY_FOUR_SEVEN

  @@map("prgd_managed_coverage")
}

enum ManagedContractStatus {
  DRAFT
  ONBOARDING
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("prgd_managed_contract_status")
}

/// Working calendar for business hours SLAs: SA is Sunday to Thursday in Asia/Riyadh, TR is Monday to Friday in Europe/Istanbul.
enum ManagedCalendar {
  SA
  TR

  @@map("prgd_managed_calendar")
}

enum ManagedPriority {
  P1
  P2
  P3
  P4

  @@map("prgd_managed_priority")
}

enum ManagedAssetKind {
  PLATFORM_SERVER
  EXTERNAL_SERVER
  SITE

  @@map("prgd_managed_asset_kind")
}

enum ManagedAssetStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("prgd_managed_asset_status")
}

enum ManagedAssetHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY

  @@map("prgd_managed_asset_health")
}

enum ResponsibilityOwner {
  PROGRID
  CUSTOMER
  SHARED

  @@map("prgd_responsibility_owner")
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO

  @@map("prgd_alert_severity")
}

enum AlertStatus {
  FIRING
  ACKNOWLEDGED
  RESOLVED

  @@map("prgd_alert_status")
}

enum OnCallRole {
  PRIMARY
  SECONDARY

  @@map("prgd_on_call_role")
}

enum PageChannel {
  SMS
  WHATSAPP
  PUSH
  EMAIL

  @@map("prgd_page_channel")
}

enum MaintenanceKind {
  PATCHING
  BACKUP_TEST
  CUSTOM

  @@map("prgd_maintenance_kind")
}

enum MaintenanceRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("prgd_maintenance_run_status")
}

enum MonthlyReportStatus {
  DRAFT
  SENT

  @@map("prgd_monthly_report_status")
}

/// A managed cloud plan. priceMinor null means a custom price set on each contract.
model ManagedPlan {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  priceMinor  Int?
  currency    Currency        @default(SAR)
  /// null means no fixed limit (set per contract).
  maxAssets   Int?
  coverage    ManagedCoverage
  includedEngineerMinutes Int @default(0)
  /// Overage rate for billable engineer time beyond the included minutes, per hour.
  hourlyRateMinor Int
  /// Minutes per priority: {"P1":240,"P2":480,"P3":960,"P4":2400}. Business minutes on BUSINESS_HOURS plans.
  responseTargets Json
  resolveTargets  Json
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contracts ManagedContract[]

  @@map("prgd_managed_plans")
}

model ManagedContract {
  id        String                @id @default(cuid())
  teamId    String
  planId    String
  status    ManagedContractStatus @default(DRAFT)
  calendar  ManagedCalendar       @default(SA)
  /// Billing currency (the team's invoice currency).
  currency  Currency
  /// Monthly fee in `currency` minor units; overrides the plan price (required for custom plans).
  priceOverrideMinor Int?
  includedMinutesOverride Int?
  maxAssetsOverride Int?
  liabilityCapMinor Int?
  /// Customer signatory named on the signed contract.
  signedByName String?
  signedAt     DateTime?
  /// Staff member who countersigned and activated the contract.
  signedById   String?
  /// Activated a 24/7 plan with fewer than two people on call (recorded in the audit log too).
  onCallOverride Boolean @default(false)
  termMonths  Int       @default(12)
  termEndsAt  DateTime?
  renewedAt   DateTime?
  requestedById String?
  notes       String?
  onboardingStartedAt DateTime?
  /// Start of billing: the plan fee accrues from here.
  activatedAt DateTime?
  suspendedAt DateTime?
  /// Past suspensions [{from, to}] so the plan fee skips them.
  suspensions Json @default("[]")
  cancelledAt DateTime?
  cancelReason String?
  /// Which engineers may be assigned, paged and granted access (checked against EngineerProfile.country).
  accessPolicy ContractAccessPolicy @default(ANY)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team     Team        @relation(fields: [teamId], references: [id])
  plan     ManagedPlan @relation(fields: [planId], references: [id])
  engineerAssignments EngineerAssignment[]
  accessGrants        AccessGrant[]
  signedBy User?       @relation(fields: [signedById], references: [id], onDelete: SetNull)
  onboardingItems  OnboardingItem[]
  assets           ManagedAsset[]
  responsibilities Responsibility[]
  alerts           Alert[]
  tickets          Ticket[]
  maintenanceTasks MaintenanceTask[]
  workLogs         WorkLog[]
  reports          MonthlyReport[]

  @@index([teamId, status])
  @@index([status])

  @@map("prgd_managed_contracts")
}

model OnboardingItem {
  id         String    @id @default(cuid())
  contractId String
  key        String
  title      String
  sortOrder  Int       @default(0)
  done       Boolean   @default(false)
  doneById   String?
  doneAt     DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  contract ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  doneBy   User?           @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([contractId, key])

  @@map("prgd_onboarding_items")
}

model ManagedAsset {
  id         String             @id @default(cuid())
  contractId String
  kind       ManagedAssetKind
  /// Set for PLATFORM_SERVER assets: the Progrid server.
  serverId   String?
  name       String
  /// Public address or URL (a site's URL, a server's public IP or hostname).
  address    String?
  /// Management network address (WireGuard or private IP) maintenance runs connect to.
  managementAddress String?
  /// Hosting provider for external assets (AWS, Hetzner, on premises ...).
  provider   String?
  os         String?
  status     ManagedAssetStatus @default(PENDING)
  monitoringEnabled Boolean     @default(true)
  backupEnabled     Boolean     @default(false)
  lastHeartbeatAt   DateTime?
  health     ManagedAssetHealth @default(UNKNOWN)
  /// Last heartbeat body from the monitoring agent.
  heartbeatReport Json?
  /// sha256 of the agent token; the token itself is shown once.
  heartbeatTokenHash String?    @unique
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  rejectedReason String?
  notes      String?
  removedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  contract ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  server   Server?         @relation(fields: [serverId], references: [id], onDelete: SetNull)
  alerts   Alert[]
  tickets  Ticket[]
  maintenanceTasks MaintenanceTask[]
  accessGrants AccessGrant[]

  @@index([contractId, status])
  @@index([status, kind, lastHeartbeatAt])

  @@map("prgd_managed_assets")
}

/// Shared responsibility matrix row: who owns an area of operations.
model Responsibility {
  id         String              @id @default(cuid())
  contractId String
  area       String
  owner      ResponsibilityOwner
  notes      String?
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  contract ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, area])

  @@map("prgd_responsibilities")
}

/// An alert from Alertmanager or the heartbeat monitor, deduplicated by fingerprint while open.
model Alert {
  id          String        @id @default(cuid())
  assetId     String
  contractId  String
  fingerprint String
  /// Equals fingerprint while the alert is open and null once resolved: at most one open alert per fingerprint.
  openKey     String?       @unique
  name        String
  summary     String?
  severity    AlertSeverity
  status      AlertStatus   @default(FIRING)
  /// alertmanager | heartbeat
  source      String        @default("alertmanager")
  labels      Json          @default("{}")
  annotations Json          @default("{}")
  startsAt    DateTime
  endsAt      DateTime?
  lastReceivedAt DateTime   @default(now())
  ticketId    String?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  asset          ManagedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  contract       ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ticket         Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  acknowledgedBy User?           @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)
  pages          Page[]

  @@index([contractId, status])
  @@index([assetId, startsAt])
  @@index([status, severity])

  @@map("prgd_alerts")
}

model OnCallShift {
  id          String     @id @default(cuid())
  userId      String
  role        OnCallRole @default(PRIMARY)
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  createdById String?
  /// Ops console: when the engineer started the shift, after the start checklist.
  startedAt   DateTime?
  /// When the engineer ended it with a handover. An ended shift no longer receives pages.
  endedAt     DateTime?
  /// {pagingAppOnline, vpnWorking, twoFactorWorking, lastHandoverRead, lastHandoverId, at}
  startChecklist Json?
  handoverRemindedAt  DateTime?
  handoverEscalatedAt DateTime?
  /// The contractor payout that paid this shift's standby fee.
  payoutId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handover Handover?
  payout   ContractorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@index([userId, startsAt])

  @@map("prgd_on_call_shifts")
}

/// One notification to one staff member about an alert or a ticket.
model Page {
  id        String      @id @default(cuid())
  alertId   String?
  ticketId  String?
  userId    String
  channel   PageChannel
  /// Adapter that delivered it: log, twilio_sms, twilio_whatsapp, push_webhook, email.
  provider  String
  /// high pages the on call engineer and escalates without an acknowledgement; low is a warning.
  urgency   String      @default("high")
  message   String
  error     String?
  sentAt    DateTime?
  ackAt     DateTime?
  ackById   String?
  escalatedAt DateTime?
  /// The page this one escalated from.
  escalatedFromId String?
  createdAt DateTime    @default(now())

  alert  Alert?  @relation(fields: [alertId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ackAt])
  @@index([alertId])
  @@index([ticketId])

  @@map("prgd_pages")
}

model MaintenanceTask {
  id         String          @id @default(cuid())
  contractId String
  /// null runs against every approved asset of the contract with a management address.
  assetId    String?
  kind       MaintenanceKind
  name       String
  /// Five field cron expression in `timezone`, e.g. "0 3 * * 5" (Friday 03:00).
  cron       String
  timezone   String          @default("Asia/Riyadh")
  /// Playbook file in MAINTENANCE_PLAYBOOK_DIR, e.g. patching.yml.
  playbook   String
  /// Extra variables for the playbook.
  vars       Json            @default("{}")
  enabled    Boolean         @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdById String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  contract ManagedContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset    ManagedAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  runs     MaintenanceRun[]

  @@index([enabled, nextRunAt])
  @@index([contractId])

  @@map("prgd_maintenance_tasks")
}

model MaintenanceRun {
  id         String               @id @default(cuid())
  taskId     String
  status     MaintenanceRunStatus @default(QUEUED)
  /// schedule | manual | retry (a failed run started again from the ops console)
  trigger    String               @default("schedule")
  startedById String?
  runner     String?
  startedAt  DateTime?
  finishedAt DateTime?
  log        String               @default("")
  error      String?
  ticketId   String?
  createdAt  DateTime             @default(now())

  task   MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  workLogs WorkLog[]
  timers   WorkTimer[]
  accessGrants AccessGrant[]

  @@index([taskId, createdAt])
  @@index([status])

  @@map("prgd_maintenance_runs")
}

/// Engineer time. Only APPROVED (and later PAID) entries count: billable minutes beyond the plan's included
/// minutes are billed as overage at month end, and contractor payouts are computed from the same rows.
model WorkLog {
  id         String    @id @default(cuid())
  contractId String
  ticketId   String?
  userId     String
  minutes    Int
  billable   Boolean   @default(true)
  note       String?
  workedAt   DateTime  @default(now())
  /// DRAFT (timer stopped or manual entry) to SUBMITTED to APPROVED or REJECTED, then PAID with a contractor payout.
  /// Back office entries by staff are APPROVED at once.
  status     WorkLogStatus @default(DRAFT)
  source     WorkLogSource @default(MANUAL)
  /// The engineer profile, for contractor pay; null for staff without one.
  engineerId String?
  maintenanceRunId String?
  /// Work window: the timer's start and stop, or the start an engineer gave for a manual entry.
  startedAt  DateTime?
  endedAt    DateTime?
  /// Why a manual entry was needed; manual entries are flagged for review.
  reason     String?
  flagged    Boolean   @default(false)
  /// Minutes of terminal sessions of the engineer inside the work window, shown next to the entry.
  sessionMinutes Int   @default(0)
  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewComment String?
  /// The contractor payout that paid this entry.
  payoutId     String?
  /// Month (UTC start) whose overage calculation counted this entry; set by the billing hook.
  billedPeriod    DateTime?
  /// Invoice that carried that month's managed lines.
  billedInvoiceId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract      ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ticket        Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user          User            @relation(fields: [userId], references: [id])
  billedInvoice Invoice?        @relation(fields: [billedInvoiceId], references: [id], onDelete: SetNull)
  engineer      EngineerProfile? @relation(fields: [engineerId], references: [id], onDelete: SetNull)
  maintenanceRun MaintenanceRun? @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  timer         WorkTimer?
  payout        ContractorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([contractId, workedAt])
  @@index([contractId, billedPeriod])
  @@index([userId, workedAt])
  @@index([status, userId])

  @@map("prgd_work_logs")
}

/// Internal knowledge base article (markdown).
model Runbook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  tags        String[] @default([])
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([title])

  @@map("prgd_runbooks")
}

model MonthlyReport {
  id         String              @id @default(cuid())
  contractId String
  /// "2026-09"
  period     String
  status     MonthlyReportStatus @default(DRAFT)
  data       Json
  /// Engineer written, editable until the report is sent.
  recommendations String         @default("")
  /// Rendered PDF (a few tens of kilobytes).
  pdf        Bytes?
  generatedAt DateTime           @default(now())
  sentAt     DateTime?
  sentById   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  contract ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, period])

  @@map("prgd_monthly_reports")
}

/// Public holidays for business hours SLAs. Hijri based dates must be confirmed by staff every year.
model Holiday {
  id      String          @id @default(cuid())
  country ManagedCalendar
  date    DateTime        @db.Date
  name    String

  @@unique([country, date])

  @@map("prgd_holidays")
}

/// ---------------------------------------------------------------------------
/// DevOps console (apps/ops, /ops/v1): engineers who operate managed contracts.
/// See docs/devops-console.md.
/// ---------------------------------------------------------------------------
enum EngineerKind {
  /// Hourly paid contractor. Not staff: never reaches /admin or customer endpoints.
  EXTERNAL
  /// Progrid employee (usually also staff with the engineer or support_lead area).
  INTERNAL

  @@map("prgd_engineer_kind")
}

enum EngineerStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED

  @@map("prgd_engineer_status")
}

/// Who may work on a contract, by the engineer's country.
enum ContractAccessPolicy {
  ANY
  SAUDI_ONLY
  TURKIYE_ONLY

  @@map("prgd_contract_access_policy")
}

/// An engineer who works in the ops console. Paging phone and channel come from the User.
model EngineerProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  kind            EngineerKind   @default(EXTERNAL)
  status          EngineerStatus @default(ACTIVE)
  /// ISO 3166-1 alpha-2 country the engineer works from (SA, TR, JO, IN ...).
  country         String
  /// IANA zone the ops console shows times in.
  timezone        String         @default("Asia/Riyadh")
  /// Contractor pay per hour of approved work, in `currency` minor units. Null until set by full staff.
  hourlyRateMinor Int?
  /// Standby fee per completed on call shift, in `currency` minor units.
  standbyFeeMinor Int?
  currency        Currency       @default(USD)
  /// Pay multiplier for work between 22:00 and 06:00 contract local time.
  nightMultiplier Float          @default(1.5)
  /// CIDRs the engineer may use the ops console from; empty allows any address.
  ipAllowlist     String[]       @default([])
  statusReason    String?
  suspendedAt     DateTime?
  offboardedAt    DateTime?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments EngineerAssignment[]
  workLogs    WorkLog[]
  payouts     ContractorPayout[]

  @@index([status])
  @@map("prgd_engineer_profiles")
}

/// A contract an engineer may work on. External engineers see nothing else.
model EngineerAssignment {
  id          String   @id @default(cuid())
  engineerId  String
  contractId  String
  createdById String?
  createdAt   DateTime @default(now())

  engineer EngineerProfile @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  contract ManagedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([engineerId, contractId])
  @@index([contractId])
  @@map("prgd_engineer_assignments")
}

/// A WebAuthn authenticator (security key or passkey) for ops console sign in.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  /// base64url credential id from the authenticator.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prgd_webauthn_credentials")
}

/// Ops console settings (one row). Missing keys fall back to the defaults in modules/ops/settings.
model OpsSettings {
  id          String   @id @default("default")
  data        Json     @default("{}")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("prgd_ops_settings")
}

enum WorkLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID

  @@map("prgd_work_log_status")
}

enum WorkLogSource {
  TIMER
  MANUAL

  @@map("prgd_work_log_source")
}

/// A running (or stopped) work timer. One running timer per engineer (partial unique index on userId
/// where stoppedAt is null). Stopping it creates a DRAFT worklog.
model WorkTimer {
  id               String    @id @default(cuid())
  userId           String
  engineerId       String?
  contractId       String
  ticketId         String?
  maintenanceRunId String?
  note             String?
  startedAt        DateTime  @default(now())
  /// Ticket actions, terminal session events and heartbeats from the ops console move this forward.
  lastActivityAt   DateTime  @default(now())
  /// When the idle prompt went out; cleared by the next activity.
  promptedAt       DateTime?
  stoppedAt        DateTime?
  /// manual | idle | ticket_closed | offboarded
  stopReason       String?
  workLogId        String?   @unique
  createdAt        DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket  Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  run     MaintenanceRun? @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  workLog WorkLog?        @relation(fields: [workLogId], references: [id], onDelete: SetNull)

  @@index([userId, stoppedAt])
  @@map("prgd_work_timers")
}

enum AccessGrantStatus {
  /// Waiting for a support lead.
  REQUESTED
  /// Approved; the access grant workflow activates it at once.
  APPROVED
  /// Usable until expiresAt: terminal sessions get certificates valid until then.
  ACTIVE
  DENIED
  EXPIRED
  REVOKED

  @@map("prgd_access_grant_status")
}

/**
 * Time limited access for one engineer to one asset, bound to one ticket or maintenance run.
 * There is no standing access: terminal sessions need an ACTIVE grant (docs/devops-console.md).
 */
model AccessGrant {
  id               String            @id @default(cuid())
  userId           String
  /// Engineer profile; null for internal staff without one.
  engineerId       String?
  contractId       String
  assetId          String
  ticketId         String?
  maintenanceRunId String?
  reason           String
  requestedMinutes Int
  status           AccessGrantStatus @default(REQUESTED)
  /// Approved by the rule (P1 or P2 ticket, engineer on call, asset assigned) instead of a lead.
  auto             Boolean           @default(false)
  /// P1 or P2 work: the grant survives the end of the engineer's shift.
  emergency        Boolean           @default(false)
  /// Minutes granted (the rule's fixed duration, or what the lead approved).
  grantedMinutes   Int?
  approvedById     String?
  approvedAt       DateTime?
  deniedById       String?
  denyReason       String?
  startsAt         DateTime?
  expiresAt        DateTime?
  extensions       Int               @default(0)
  extendedAt       DateTime?
  extensionReason  String?
  revokedAt        DateTime?
  revokedById      String?
  /// staff | ticket_closed | shift_end | offboarded | suspended | unassigned | residency, or the staff member's reason.
  revokeReason     String?
  /// Serial of the latest certificate issued under this grant.
  certSerial       String?
  /// SSH principals the certificates carry (the asset's principal only).
  principals       String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract     ManagedContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset        ManagedAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ticket       Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  run          MaintenanceRun?  @relation(fields: [maintenanceRunId], references: [id], onDelete: SetNull)
  certificates SshCertificate[]
  sessions     TerminalSession[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([ticketId])
  @@index([assetId, startsAt])
  @@map("prgd_access_grants")
}

/// The development certificate authority (PRGD_SSH_CA=local). The private key is sealed with the secretbox key.
model SshCaKey {
  id         String   @id @default(cuid())
  name       String   @unique
  /// OpenSSH public key line; hosts trust it with TrustedUserCAKeys.
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("prgd_ssh_ca_keys")
}

/// Every SSH user certificate the platform signed, so each can be revoked by serial.
model SshCertificate {
  id          String    @id @default(cuid())
  grantId     String
  sessionId   String?
  /// uint64 serial, decimal.
  serial      String    @unique
  keyId       String
  principals  String[]
  /// SHA256 fingerprint of the certified public key (the gateway's ephemeral key).
  fingerprint String
  validAfter  DateTime
  validBefore DateTime
  /// local | step-ca
  ca          String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  grant AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("prgd_ssh_certificates")
}

enum TerminalSessionStatus {
  /// Opened in the ops console; the one time gateway token is not used yet.
  PENDING
  /// The gateway checked the token and connected.
  ACTIVE
  ENDED
  /// Ended by staff, or because its grant was revoked or expired.
  KILLED
  FAILED
  /// The gateway token was never used.
  EXPIRED

  @@map("prgd_terminal_session_status")
}

/// A browser terminal session through prgd-gateway, recorded as asciicast v2 in object storage.
model TerminalSession {
  id               String                @id @default(cuid())
  grantId          String
  userId           String
  contractId       String
  assetId          String
  ticketId         String?
  maintenanceRunId String?
  /// sha256 of the one time gateway token (prgd_gws_...), valid for PRGD_GATEWAY_TOKEN_TTL_SECONDS.
  tokenHash        String                @unique
  tokenExpiresAt   DateTime
  tokenUsedAt      DateTime?
  status           TerminalSessionStatus @default(PENDING)
  gatewayId        String?
  clientIp         String?
  startedAt        DateTime?
  endedAt          DateTime?
  lastEventAt      DateTime?
  bytesIn          BigInt                @default(0)
  bytesOut         BigInt                @default(0)
  /// Object key in PRGD_RECORDINGS_BUCKET; deleted after the retention period (recordingExpiredAt).
  recordingKey     String?
  recordingSize    BigInt?
  recordingStoredAt  DateTime?
  recordingExpiredAt DateTime?
  certSerial       String?
  killedById       String?
  killReason       String?
  /// Why the session ended, as the gateway reported it (client_closed, grant_expired, killed, error).
  endReason        String?
  createdAt        DateTime              @default(now())

  grant AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([status])
  @@index([grantId])
  @@index([assetId, startedAt])
  @@index([recordingExpiredAt, startedAt])
  @@map("prgd_terminal_sessions")
}

/// Secrets the gateway injects into terminal sessions, for PRGD_SECRET_STORE=local (development). Values sealed.
model OpsSecret {
  id          String   @id @default(cuid())
  /// assets/<assetId>
  ref         String   @unique
  values      String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prgd_ops_secrets")
}

/// What an engineer hands to the next shift. Ending a shift requires one.
model Handover {
  id                 String   @id @default(cuid())
  shiftId            String   @unique
  authorId           String
  /// Open tickets of the author at the end of the shift: [{id, number, subject, priority, status, contractId}].
  openTickets        Json     @default("[]")
  risks              String   @default("")
  pendingMaintenance String   @default("")
  notes              String   @default("")
  /// Users who read it (the start checklist needs the last handover read).
  readBy             String[] @default([])
  createdAt          DateTime @default(now())

  shift OnCallShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("prgd_handovers")
}

enum PostmortemStatus {
  DRAFT
  SUBMITTED
  CLOSED

  @@map("prgd_postmortem_status")
}

/// Required after every managed P1: the ticket stays resolved_pending_pm until it is submitted. A support lead closes it.
model Postmortem {
  id          String           @id @default(cuid())
  ticketId    String           @unique
  authorId    String?
  /// Markdown sections (spec template).
  timeline    String           @default("")
  impact      String           @default("")
  rootCause   String           @default("")
  fix         String           @default("")
  prevention  String           @default("")
  status      PostmortemStatus @default(DRAFT)
  /// 48 hours (postmortemDueHours) after the ticket was resolved.
  dueAt       DateTime
  submittedAt DateTime?
  submittedById String?
  closedById  String?
  closedAt    DateTime?
  closeComment String?
  remindedAt  DateTime?
  overdueNotifiedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("prgd_postmortems")
}

enum ContractorPayoutStatus {
  DRAFT
  /// Sent to the engineer with the PDF statement.
  ISSUED
  /// Paid outside the platform (bank transfer); the reference is recorded.
  PAID

  @@map("prgd_contractor_payout_status")
}

/**
 * Monthly pay of an external engineer: standby fee per completed shift plus APPROVED worklog
 * minutes at the hourly rate, with the night multiplier for 22:00 to 06:00 contract local time.
 * Amounts in the engineer's currency, minor units.
 */
model ContractorPayout {
  id              String                 @id @default(cuid())
  engineerId      String
  userId          String
  /// "2026-09"
  period          String
  currency        Currency
  hourlyRateMinor Int
  standbyFeeMinor Int
  nightMultiplier Float
  standbyShifts   Int
  standbyMinor    Int
  workedMinutes   Int
  nightMinutes    Int
  workMinor       Int
  totalMinor      Int
  /// Statement lines: [{workLogId, contractId, customer, ticketNumber, startedAt, minutes, nightMinutes, amountMinor}] and shifts.
  lines           Json                   @default("{}")
  status          ContractorPayoutStatus @default(DRAFT)
  issuedAt        DateTime?
  paidAt          DateTime?
  paidReference   String?
  paidById        String?
  /// PDF statement in the invoice style.
  statement       Bytes?
  generatedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  engineer EngineerProfile @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  workLogs WorkLog[]
  shifts   OnCallShift[]

  @@unique([engineerId, period])
  @@index([period, status])
  @@map("prgd_contractor_payouts")
}
