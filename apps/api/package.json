{
  "name": "@prgd/api",
  "version": "0.1.0",
  "private": true,
  "description": "prgd control plane — NestJS modular monolith",
  "scripts": {
    "dev": "nest start --watch",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/integration",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test:integration": "vitest run --config test/integration/vitest.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/server": "^13.3.3",
    "@temporalio/activity": "^1.11.5",
    "@temporalio/client": "^1.11.5",
    "@temporalio/worker": "^1.11.5",
    "@temporalio/workflow": "^1.11.5",
    "ajv": "^8.20.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.5",
    "nats": "^2.29.1",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
